<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">
  <targets async="true">
    <target xsi:type="File"
            name="serviceFile"
            fileName="${basedir}/logs/service/service.log"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveSuffixFormat="_{0:00}"
            maxArchiveFiles="10"
            maxArchiveDays="7"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <!-- Keep the first identical warning/error, then at most one per minute. -->
    <logger name="*" minlevel="Warn" writeTo="serviceFile" final="true">
      <filters defaultAction="Log">
        <whenRepeated layout="${logger}|${level}|${message}|${exception:format=type,message}"
                      timeoutSeconds="60" includeFirst="false" maxLength="8192"
                      maxFilterCacheSize="10000" action="Ignore"
                      filterCountMessageAppendFormat=" [suppressed repeats: {0}]" />
      </filters>
    </logger>
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="serviceFile" />
  </rules>
</nlog>
