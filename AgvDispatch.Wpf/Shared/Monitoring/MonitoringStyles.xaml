<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  <Setter Property="RowHeight" Value="38"/>
  <Setter Property="ColumnHeaderHeight" Value="38"/>
  <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
  <Setter Property="AlternatingRowBackground" Value="{DynamicResource MutedSurfaceBrush}"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
 </Style>
 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppDataGridHeaderStyle}">
  <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="8,6"/>
 </Style>
 <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="BorderThickness" Value="0"/>
 </Style>
 <Style x:Key="MonitorTextStyle" TargetType="TextBlock">
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="8,0"/>
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <Style.Triggers>
   <Trigger Property="Text" Value="正常"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></Trigger>
   <Trigger Property="Text" Value="故障"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Trigger>
   <Trigger Property="Text" Value="急停"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Trigger>
   <Trigger Property="Text" Value="数据过期"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></Trigger>
   <Trigger Property="Text" Value="通信未启用"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
