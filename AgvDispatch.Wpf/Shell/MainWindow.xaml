<Window x:Class="AgvDispatch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:services="clr-namespace:AgvDispatch.Wpf.Services"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="/AgvDispatch.Wpf;component/Assets/Icons/AppIcon.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI"
        Loaded="OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SidebarVisibility"/>
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Padding" Value="4,7"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SettingsActionStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionSurface" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="6" Padding="12,0">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="{DynamicResource AccentMutedBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderBrandIcon" Width="36" Height="36" CornerRadius="9" BorderBrush="#6ED6F4" BorderThickness="1" Margin="0,0,12,0">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2BAFD9" Offset="0"/><GradientStop Color="#1378B9" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Viewbox Margin="5" Stretch="Uniform"><Canvas Width="28" Height="28">
                            <Path Data="M5,15 L5,9 Q5,6 8,6 L16,6 Q19,6 19,9 L19,15 M8,6 L8,3 L16,3 L16,6 M3,15 L23,15 L23,22 L3,22 Z M8,10 L16,10" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                            <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="5" Canvas.Top="22"/><Ellipse Width="4" Height="4" Fill="White" Canvas.Left="17" Canvas.Top="22"/>
                            <Path Data="M22,5 L26,5 L26,11 M23,8 L26,11 L28,8" Stroke="#B9F3FF" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                            <Rectangle Width="7" Height="2" RadiusX="1" RadiusY="1" Fill="#B9F3FF" Canvas.Left="9.5" Canvas.Top="18"/>
                        </Canvas></Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="铝屑回收智能调度平台" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="AGV FLEET &amp; TRAFFIC CONTROL" Foreground="#FF83A8BD" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" BorderBrush="#3F6DAF" BorderThickness="1,0,0,0" Padding="24,0,0,0" VerticalAlignment="Center">
                    <StackPanel><TextBlock Text="{Binding CurrentPage}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ClientBuild}" ToolTip="{Binding ClientBuild}" Foreground="#ABC7D8" FontSize="10" MaxWidth="350" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderClockPanel" Height="36" CornerRadius="8" Background="#142E4B" BorderBrush="#436483" BorderThickness="1" Padding="12,0" Margin="0,0,12,0"
                            ToolTip="{Binding CurrentTimestamp}" AutomationProperties.Name="{Binding CurrentTimestamp}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderClockDate" Text="{Binding HeaderDate}" Foreground="#F5FAFF" FontFamily="Bahnschrift, Consolas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Background="#23445F" BorderBrush="#3E6986" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderClockWeekday" Text="{Binding HeaderWeekday}" Foreground="#9FE7F7" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Width="1" Height="18" Background="#476B8B" Margin="12,0"/>
                            <TextBlock x:Name="HeaderClock" Text="{Binding HeaderTime}" Foreground="#F5FAFF" FontFamily="Bahnschrift, Consolas" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Width="65" TextAlignment="Right"/>
                            <TextBlock Text=":" Foreground="#72D9F3" FontFamily="Bahnschrift, Consolas" FontSize="21" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderClockSeconds" Text="{Binding HeaderSeconds}" Foreground="#72D9F3" FontFamily="Bahnschrift, Consolas" FontSize="21" Width="27" VerticalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="SettingsToggle" ToolTip="外观设置" Height="32" Padding="12,0">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="SettingsSurface" Background="#22445F" BorderBrush="#3B5E78" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SettingsSurface" Property="Background" Value="#315D7B"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="SettingsSurface" Property="Background" Value="#315D7B"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="设置" Foreground="White" FontSize="12"/></StackPanel>
                    </ToggleButton>
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Width="300">
                            <StackPanel>
                                <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SettingsActionStyle}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/><TextBlock Text="{Binding ThemeLabel, StringFormat=切换为{0}}"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Width="258" services:SidebarMotion.IsExpanded="{Binding IsSidebarExpanded}" ClipToBounds="True" Background="{DynamicResource AsideBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,10,8,4">
                        <ToggleButton x:Name="SidebarToggle" IsChecked="{Binding IsSidebarExpanded, Mode=TwoWay}" ToolTip="{Binding SidebarToggleHint}" AutomationProperties.Name="{Binding SidebarToggleHint}" Width="34" Height="32" Cursor="Hand">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleSurface" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource AccentMutedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                            <TextBlock Text="{Binding SidebarToggleGlyph}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="15"/>
                        </ToggleButton>
                        <TextBlock Text="功能导航" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource SidebarVisibility}}"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavigationButtonStyle}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                            Click="NavigationButton_OnClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Background="{DynamicResource AccentMutedBrush}">
                                                <Image Source="{Binding Icon}" Width="19" Height="19" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarVisibility}}">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›" Width="18" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarVisibility}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" prism:RegionManager.RegionName="ContentRegion" />
        </Grid>

        <Border Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Style="{StaticResource FooterStatusItemStyle}">
                    <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{DynamicResource WarningBrush}" />
                    <TextBlock Text="PLC 未配置" />
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource FooterStatusItemStyle}">
                    <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{DynamicResource WarningBrush}" />
                    <TextBlock Text="AGV 未配置" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource FooterStatusItemStyle}">
                    <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{DynamicResource InfoBrush}" />
                    <TextBlock Text="后台服务 IPC" />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource FooterStatusItemStyle}">
                    <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{DynamicResource OfflineBrush}" />
                    <TextBlock Text="等待任务 0" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="{Binding VersionText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <StackPanel Grid.RowSpan="3" hc:Growl.Token="ShellNotifications" Width="380"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,20,0"
                    Panel.ZIndex="100" />
    </Grid>
</Window>
