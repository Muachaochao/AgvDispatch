<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light counterpart of the cockpit palette. The header bar stays dark in both themes;
         status text uses deeper green/amber/red so small labels stay >= 4.5:1 on white. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF3F8" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0A1626" />
    <SolidColorBrush x:Key="AsideBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FooterBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#F3F7FB" />
    <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#E4ECF4" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#EAF1F8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5E0EB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B4C5D6" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F1B2D" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3B4D63" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#52657B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#155E75" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#E3F5F9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
    <SolidColorBrush x:Key="WarningBrush" Color="#92400E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#52657B" />
    <SolidColorBrush x:Key="SuccessMutedBrush" Color="#E3F6EE" />
    <SolidColorBrush x:Key="WarningMutedBrush" Color="#FDF3E1" />
    <SolidColorBrush x:Key="DangerMutedBrush" Color="#FCE9E9" />
    <SolidColorBrush x:Key="InfoMutedBrush" Color="#F0EAFD" />
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E7490" Offset="0" />
        <GradientStop Color="#155E75" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderAccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0022D3EE" Offset="0" />
        <GradientStop Color="#C022D3EE" Offset="0.22" />
        <GradientStop Color="#6022D3EE" Offset="0.7" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="AccentGlowColor">#0E7490</Color>
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#0E7490" BlurRadius="12" ShadowDepth="0" Opacity="0.22" />
    <DropShadowEffect x:Key="AccentGlowSoftEffect" Color="#0E7490" BlurRadius="6" ShadowDepth="0" Opacity="0.30" />
    <!-- HC semantic colors share the same application palette, including popups. -->
    <Color x:Key="PrimaryColor">#0E7490</Color>
    <Color x:Key="DarkPrimaryColor">#155E75</Color>
    <Color x:Key="LightPrimaryColor">#E3F5F9</Color>
    <Color x:Key="PrimaryTextColor">#0F1B2D</Color>
    <Color x:Key="SecondaryTextColor">#3B4D63</Color>
    <Color x:Key="ThirdlyTextColor">#52657B</Color>
    <Color x:Key="ReverseTextColor">#0F1B2D</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D5E0EB</Color>
    <Color x:Key="SecondaryBorderColor">#B4C5D6</Color>
    <Color x:Key="BackgroundColor">#EEF3F8</Color>
    <Color x:Key="RegionColor">#FFFFFF</Color>
    <Color x:Key="SecondaryRegionColor">#F3F7FB</Color>
    <Color x:Key="ThirdlyRegionColor">#FFFFFF</Color>
    <Color x:Key="DefaultColor">#FFFFFF</Color>
    <Color x:Key="DarkDefaultColor">#EAF1F8</Color>
    <Color x:Key="TitleColor">#0E7490</Color>
    <Color x:Key="SecondaryTitleColor">#155E75</Color>
</ResourceDictionary>
