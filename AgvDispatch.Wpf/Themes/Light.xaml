<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#17365D" />
    <SolidColorBrush x:Key="AsideBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FooterBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EC" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2939" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F73D9" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#087F5B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A75A05" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C83232" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2068B0" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#667085" />
    <!-- HC semantic colors share the same application palette, including popups. -->
    <Color x:Key="PrimaryColor">#2F73D9</Color>
    <Color x:Key="DarkPrimaryColor">#245FB8</Color>
    <Color x:Key="LightPrimaryColor">#EAF2FF</Color>
    <Color x:Key="PrimaryTextColor">#1D2939</Color>
    <Color x:Key="SecondaryTextColor">#667085</Color>
    <Color x:Key="ThirdlyTextColor">#667085</Color>
    <Color x:Key="ReverseTextColor">#1D2939</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DCE3EC</Color>
    <Color x:Key="SecondaryBorderColor">#99AABD</Color>
    <Color x:Key="BackgroundColor">#F5F7FB</Color>
    <Color x:Key="RegionColor">#FFFFFF</Color>
    <Color x:Key="SecondaryRegionColor">#F1F4F8</Color>
    <Color x:Key="ThirdlyRegionColor">#FFFFFF</Color>
    <Color x:Key="DefaultColor">#FFFFFF</Color>
    <Color x:Key="DarkDefaultColor">#F1F4F8</Color>
    <Color x:Key="TitleColor">#2F73D9</Color>
    <Color x:Key="SecondaryTitleColor">#2F73D9</Color>
</ResourceDictionary>
