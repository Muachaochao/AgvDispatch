<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0B1F36" />
    <SolidColorBrush x:Key="AsideBrush" Color="#182230" />
    <SolidColorBrush x:Key="FooterBrush" Color="#182230" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#263445" />
    <SolidColorBrush x:Key="BorderBrush" Color="#344054" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B2B9C6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#53A1FF" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1B3B64" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#32D583" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FDB022" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F97066" />
    <SolidColorBrush x:Key="InfoBrush" Color="#53B1FD" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#98A2B3" />
    <!-- HC semantic colors share the same application palette, including popups. -->
    <Color x:Key="PrimaryColor">#2F73D9</Color>
    <Color x:Key="DarkPrimaryColor">#245FB8</Color>
    <Color x:Key="LightPrimaryColor">#1B3B64</Color>
    <Color x:Key="PrimaryTextColor">#F2F4F7</Color>
    <Color x:Key="SecondaryTextColor">#B2B9C6</Color>
    <Color x:Key="ThirdlyTextColor">#98A2B3</Color>
    <Color x:Key="ReverseTextColor">#F2F4F7</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#344054</Color>
    <Color x:Key="SecondaryBorderColor">#62758B</Color>
    <Color x:Key="BackgroundColor">#111827</Color>
    <Color x:Key="RegionColor">#1F2937</Color>
    <Color x:Key="SecondaryRegionColor">#263445</Color>
    <Color x:Key="ThirdlyRegionColor">#263445</Color>
    <Color x:Key="DefaultColor">#1F2937</Color>
    <Color x:Key="DarkDefaultColor">#263445</Color>
    <Color x:Key="TitleColor">#53A1FF</Color>
    <Color x:Key="SecondaryTitleColor">#53A1FF</Color>
</ResourceDictionary>
