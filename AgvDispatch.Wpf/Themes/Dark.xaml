<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark cockpit palette, shared with the Web frontends (page #060B14, surface #0B1524, cyan #22D3EE).
         Glow and gradient keys exist in both themes; use them sparingly (primary hover, selected nav, focus). -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#060B14" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#03070D" />
    <SolidColorBrush x:Key="AsideBrush" Color="#08111E" />
    <SolidColorBrush x:Key="FooterBrush" Color="#08111E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0B1524" />
    <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#0F1C2F" />
    <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#0D1828" />
    <SolidColorBrush x:Key="DeepSurfaceBrush" Color="#03070D" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#142640" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1E3350" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2C4A6E" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6F1FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9BCD3" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7C91AB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#1F22D3EE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="InfoBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="OfflineBrush" Color="#8EA3BC" />
    <SolidColorBrush x:Key="SuccessMutedBrush" Color="#1F34D399" />
    <SolidColorBrush x:Key="WarningMutedBrush" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="DangerMutedBrush" Color="#1FF87171" />
    <SolidColorBrush x:Key="InfoMutedBrush" Color="#1FA78BFA" />
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E7490" Offset="0" />
        <GradientStop Color="#155E75" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderAccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0022D3EE" Offset="0" />
        <GradientStop Color="#C022D3EE" Offset="0.22" />
        <GradientStop Color="#6022D3EE" Offset="0.7" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </LinearGradientBrush>
    <Color x:Key="AccentGlowColor">#22D3EE</Color>
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#22D3EE" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="AccentGlowSoftEffect" Color="#22D3EE" BlurRadius="8" ShadowDepth="0" Opacity="0.55" />
    <!-- HC semantic colors share the same application palette, including popups.
         PrimaryColor stays a deep cyan so HC fills keep white text readable (>= 4.5:1). -->
    <Color x:Key="PrimaryColor">#0E7490</Color>
    <Color x:Key="DarkPrimaryColor">#155E75</Color>
    <Color x:Key="LightPrimaryColor">#0E2A3B</Color>
    <Color x:Key="PrimaryTextColor">#E6F1FF</Color>
    <Color x:Key="SecondaryTextColor">#A9BCD3</Color>
    <Color x:Key="ThirdlyTextColor">#7C91AB</Color>
    <Color x:Key="ReverseTextColor">#E6F1FF</Color>
    <Color x:Key="TextIconColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#1E3350</Color>
    <Color x:Key="SecondaryBorderColor">#2C4A6E</Color>
    <Color x:Key="BackgroundColor">#060B14</Color>
    <Color x:Key="RegionColor">#0B1524</Color>
    <Color x:Key="SecondaryRegionColor">#0F1C2F</Color>
    <Color x:Key="ThirdlyRegionColor">#0D1828</Color>
    <Color x:Key="DefaultColor">#0F1C2F</Color>
    <Color x:Key="DarkDefaultColor">#142640</Color>
    <Color x:Key="TitleColor">#22D3EE</Color>
    <Color x:Key="SecondaryTitleColor">#67E8F9</Color>
</ResourceDictionary>
