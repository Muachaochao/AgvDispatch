<Window x:Class="AgvDispatch.Wpf.Management.ManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AGV 现场管理工具" Width="1180" Height="800" MinWidth="980" MinHeight="660"
 WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
 Background="#F3F6F9" Foreground="{StaticResource Ink}" Icon="/AgvDispatch.Wpf;component/Assets/Icons/AppIcon.ico">
 <Grid Background="#F3F6F9">
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#122B3A">
   <DockPanel Margin="18,30,18,22">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,35">
     <TextBlock Text="AGV / SITE MANAGER" Foreground="#80C9BE" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBlock Text="现场管理工具" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Text="部署 · 连接 · 诊断" Foreground="#A5BAC8" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0">
     <Border Height="1" Background="#34505E" Margin="0,0,0,16"/>
     <TextBlock Text="日常业务统一在 Web 操作" Foreground="#B0C5D1" FontSize="11" Margin="0,0,0,8"/>
     <TextBlock Text="关闭此窗口，后台继续运行" Foreground="#B0C5D1" FontSize="11"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#245161"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#1D4354"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="刷新状态" Command="{Binding RefreshCommand}"/><Button Content="打开 Web ↗" Style="{StaticResource Primary}" Command="{Binding OpenWebCommand}" Margin="0"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <Grid>
     <StackPanel Visibility="{Binding OverviewVisibility}">
      <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="调度后台" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ServiceState}" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Web 服务" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding WebState}" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,0"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="运行现场" Style="{StaticResource Title}"/><TextBlock Text="{Binding Runtime}" LineHeight="25"/><WrapPanel Margin="0,20,0,0"><Button Content="六层调度监控 ↗" Command="{Binding OpenPipelineCommand}"/><Button Content="异常恢复 ↗" Command="{Binding OpenRecoveryCommand}"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="版本与数据位置" Style="{StaticResource Title}"/><TextBlock Text="{Binding Release}" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding Paths}" LineHeight="25"/><Button Content="打开运行数据目录" Command="{Binding OpenDataCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding ServiceVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="系统启停" Style="{StaticResource Title}"/><TextBlock Text="{Binding ServiceState}" Margin="0,0,0,8"/><TextBlock Text="{Binding WebState}" Margin="0,0,0,20"/><WrapPanel IsEnabled="{Binding CanOperate}"><Button Content="启动系统" Command="{Binding StartCommand}" Style="{StaticResource Primary}"/><Button Content="停止系统" Command="{Binding StopCommand}"/><Button Content="重启系统" Command="{Binding RestartCommand}"/></WrapPanel><TextBlock Text="启动沿用最新版 Web 的日常配置；停止仅管理当前版本记录的进程，并核验任务、命令、路权与车辆停稳状态。" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="下次启动配置" Style="{StaticResource Title}"/><TextBlock Text="{Binding Policy}" Margin="0,0,0,16"/><TextBlock Text="最大并发任务数"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/><Button Content="保存并备份原配置" Command="{Binding SavePolicyCommand}" HorizontalAlignment="Left"/><TextBlock Text="系统停止后可保存，下次启动生效。任务优先级、路权窗口和设备许可在 Web 工程配置中维护。" Style="{StaticResource Hint}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding NetworkVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本机网络" Style="{StaticResource Title}"/><TextBlock Text="{Binding Network}" LineHeight="26"/><WrapPanel Margin="0,18,0,0"><Button Content="Windows 网络设置 ↗" Command="{Binding NetworkSettingsCommand}"/><Button Content="复制 Web 地址" Command="{Binding CopyUrlCommand}"/></WrapPanel><TextBlock Text="Web 本机入口：http://127.0.0.1:5199/。当前版本仅监听本机，其他电脑访问不能仅靠替换 IP；本工具不会自动开放监听或修改防火墙。" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="端口连通性测试" Style="{StaticResource Title}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="目标 IP"/><TextBox Text="{Binding ProbeAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="端口"/><TextBox Text="{Binding ProbePort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><Button Content="测试连接" Command="{Binding ProbeCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ProbeResult}" Style="{StaticResource Hint}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding ConnectionVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="设备连接与配置" Style="{StaticResource Title}"/><TextBlock Text="{Binding ConnectionsState}" Style="{StaticResource Hint}"/><Button Content="打开 Web 通信配置 ↗" Command="{Binding OpenEngineeringCommand}" HorizontalAlignment="Left"/>
       <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal" RowHeight="44" MaxHeight="350" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="设备" Binding="{Binding Id}" Width="105"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="55"/><DataGridTextColumn Header="当前地址" Binding="{Binding ActiveEndpoint}" Width="145"/><DataGridTextColumn Header="已保存地址" Binding="{Binding SavedEndpoint}" Width="145"/><DataGridTextColumn Header="后台观察" Binding="{Binding State}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid>
       <TextBlock Text="连接与点位维护统一使用 Web 中的现有校验流程。修改后的配置是否生效，以后台实际配置为准。" Style="{StaticResource Hint}" Margin="0,18,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding BackupVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="完整运行数据备份" Style="{StaticResource Title}"/><TextBlock Text="包含日常数据库、地图、通信配置和 Web 工程方案；生成逐文件 SHA256 清单，并检查数据库完整性。" Style="{StaticResource Hint}"/><WrapPanel><Button Content="创建备份" Style="{StaticResource Primary}" Command="{Binding BackupCommand}"/><Button Content="打开备份目录" Command="{Binding OpenBackupCommand}"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="从备份恢复" Style="{StaticResource Title}"/><TextBlock Text="仅接收本工具生成的同版本完整备份。恢复前校验路径、文件清单、哈希及数据库；当前数据另存保留。" Style="{StaticResource Hint}"/><Button Content="选择备份并恢复…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/><TextBlock Text="备份和恢复都要求后台与 Web 已停止。恢复不自动启动系统；再次启动后，需核对现场位置、任务与恢复屏障。" Style="{StaticResource Hint}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel Visibility="{Binding LogVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="现场诊断包" Style="{StaticResource Title}"/><TextBlock Text="收集版本、运行状态、网络信息、本次管理操作和有限长度的后台日志；可在系统运行时导出。" Style="{StaticResource Hint}"/><WrapPanel><Button Content="导出诊断包" Style="{StaticResource Primary}" Command="{Binding ExportCommand}"/><Button Content="打开诊断目录" Command="{Binding OpenDiagnosticCommand}"/><Button Content="读取最近后台日志" Command="{Binding ReadLogCommand}"/></WrapPanel><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Height="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本次管理操作" Style="{StaticResource Title}"/><TextBox Text="{Binding Journal, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" MaxHeight="65" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/><TextBlock Grid.Column="1" Text="{Binding LastCheck}" Foreground="{StaticResource Muted}" Margin="18,0,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
