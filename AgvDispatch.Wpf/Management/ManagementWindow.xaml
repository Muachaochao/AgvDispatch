<Window x:Class="AgvDispatch.Wpf.Management.ManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AGV 软件助手" Width="1320" Height="820" MinWidth="1160" MinHeight="700"
 WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14"
 Background="White" Foreground="{StaticResource Ink}" Icon="/AgvDispatch.Wpf;component/Assets/Icons/AppIcon.ico">
 <Window.Resources>
  <Style x:Key="Section" TargetType="ContentControl"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid Height="42"><Border BorderBrush="#EFEFF1" BorderThickness="0,0,0,1"/><TextBlock Text="{TemplateBinding Content}" FontSize="19" VerticalAlignment="Top"/><Border Background="#EB9C55" Height="3" Width="88" HorizontalAlignment="Left" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Row" TargetType="Grid"><Setter Property="MinHeight" Value="74"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
  <Style x:Key="Cell" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="State" TargetType="TextBlock" BasedOn="{StaticResource Cell}"><Setter Property="Foreground" Value="#7B8088"/><Style.Triggers><Trigger Property="Text" Value="已连接"><Setter Property="Foreground" Value="#4C8A5D"/></Trigger><Trigger Property="Text" Value="文件可用"><Setter Property="Foreground" Value="#4C8A5D"/></Trigger><Trigger Property="Text" Value="目录可用"><Setter Property="Foreground" Value="#4C8A5D"/></Trigger></Style.Triggers></Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="FontSize" Value="13"/></Style>
 </Window.Resources>
 <Grid Background="White">
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F8F8F9" BorderBrush="#F3F3F4" BorderThickness="0,0,1,0">
   <DockPanel Margin="24,38,24,20">
    <TextBlock DockPanel.Dock="Top" Text="AGV软件助手" FontSize="25" Margin="17,6,0,70"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,30,0,0">
     <TextBlock FontSize="11" Foreground="#96999F" Margin="0,0,0,6"><Run Text="助手版本："/><Run Text="{Binding AssistantVersion, Mode=OneWay}"/></TextBlock>
     <TextBlock Text="{Binding Release}" FontSize="10" Foreground="#96999F" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <TextBlock FontSize="11"><Hyperlink Command="{Binding OpenWebCommand}" Foreground="#417B9F" TextDecorations="None">前端地址：127.0.0.1:5199 ↗</Hyperlink></TextBlock>
    </StackPanel>
    <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="22,16"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#35383D"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Nav" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="20" Foreground="#969CA6" Margin="0,0,17,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
       <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="服务管理"><Setter TargetName="Glyph" Property="Text" Value="&#xE80F;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="版本与备份"><Setter TargetName="Glyph" Property="Text" Value="&#xE896;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="软件信息"><Setter TargetName="Glyph" Property="Text" Value="&#xE946;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="日志管理"><Setter TargetName="Glyph" Property="Text" Value="&#xE9D9;"/></DataTrigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="Glyph" Property="Foreground" Value="White"/><Setter TargetName="Nav" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FC795B" Offset="0"/><GradientStop Color="#F7A150" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Nav" Property="Background" Value="#EDEEF0"/></MultiTrigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="46,24,38,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,25"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="刷新" Command="{Binding RefreshCommand}" Padding="13,6"/><Button Content="打开前端 ↗" Command="{Binding OpenWebCommand}" Padding="13,6" Margin="0,0,0,10"/></StackPanel><TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel>
     <StackPanel Visibility="{Binding ServiceVisibility}">
      <ContentControl Content="数据服务" Style="{StaticResource Section}"/>
      <Grid Margin="4,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="名称" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="连接状态" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="服务状态" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="操作" Foreground="{StaticResource Muted}"/></Grid>
      <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="SQLite 运行数据库" Style="{StaticResource Cell}"/><TextBlock Grid.Column="1" Text="{Binding DatabaseConnection}" Style="{StaticResource State}"/><TextBlock Grid.Column="2" Text="{Binding DatabaseState}" Style="{StaticResource Cell}"/><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="检查" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource RowButton}"/><Button Content="数据目录" Command="{Binding OpenDataCommand}" Style="{StaticResource RowButton}"/><Button Content="备份" Command="{Binding OpenBackupPageCommand}" Style="{StaticResource RowButton}"/></StackPanel></Grid>
      <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="Web 工程方案库" Style="{StaticResource Cell}"/><TextBlock Grid.Column="1" Text="{Binding ProjectConnection}" Style="{StaticResource State}"/><TextBlock Grid.Column="2" Text="本地文件存储" Style="{StaticResource Cell}"/><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="配置" Command="{Binding OpenEngineeringCommand}" Style="{StaticResource RowButton}"/><Button Content="备份" Command="{Binding OpenBackupPageCommand}" Style="{StaticResource RowButton}"/></StackPanel></Grid>
      <TextBlock Text="SQLite 为内嵌数据库，随后台使用，无需独立启动数据库服务。" Style="{StaticResource Hint}" FontSize="11" Margin="4,3,0,36"/>
      <ContentControl Content="调度服务" Style="{StaticResource Section}"/>
      <Grid Margin="4,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="名称" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="连接状态" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="服务状态" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="操作" Foreground="{StaticResource Muted}"/></Grid>
      <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="AgvDispatch.Service" Style="{StaticResource Cell}"/><TextBlock Grid.Column="1" Text="{Binding BackendConnection}" Style="{StaticResource State}"/><TextBlock Grid.Column="2" Text="{Binding ServiceState}" Style="{StaticResource Cell}"/><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopSystem}" Style="{StaticResource RowButton}" ToolTip="停止当前系统的后台与 Web"/><Button Content="启动" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartSystem}" Style="{StaticResource RowButton}"/><Button Content="重启" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestartSystem}" Style="{StaticResource RowButton}"/><Button Content="配置" Command="{Binding OpenSettingsCommand}" Style="{StaticResource RowButton}"/></StackPanel></Grid>
      <Grid Style="{StaticResource Row}"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><TextBlock Text="AgvDispatch.WebHost" Style="{StaticResource Cell}"/><TextBlock Grid.Column="1" Text="{Binding WebConnection}" Style="{StaticResource State}"/><TextBlock Grid.Column="2" Text="{Binding WebState}" Style="{StaticResource Cell}"/><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopSystem}" Style="{StaticResource RowButton}" ToolTip="停止当前系统的后台与 Web"/><Button Content="启动" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartSystem}" Style="{StaticResource RowButton}"/><Button Content="重启" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestartSystem}" Style="{StaticResource RowButton}"/><Button Content="配置" Command="{Binding OpenSettingsCommand}" Style="{StaticResource RowButton}"/></StackPanel></Grid>
      <TextBlock Text="后台与 Web 由统一入口联动启停，任一行的启停操作均作用于整个系统。停止前核验任务、路权及车辆状态。" Style="{StaticResource Hint}" FontSize="11" Margin="4,10,0,18"/>
      <Expander Header="运行详情与调度诊断" Margin="4,15,0,20" Foreground="#777B83"><StackPanel Margin="0,16,0,0"><TextBlock Text="{Binding Runtime}" LineHeight="24" FontSize="12"/><WrapPanel Margin="0,15,0,0"><Button Content="六层调度监控 ↗" Command="{Binding OpenPipelineCommand}"/><Button Content="异常恢复 ↗" Command="{Binding OpenRecoveryCommand}"/></WrapPanel></StackPanel></Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding BackupVisibility}">
      <ContentControl Content="当前版本" Style="{StaticResource Section}"/><TextBlock Text="{Binding Release}" FontSize="18" Margin="4,8,0,15"/><TextBlock Text="{Binding Paths}" Style="{StaticResource Hint}" Margin="4,0,0,25"/><TextBlock Text="版本切换沿用现有受控发布流程。此页维护同版本数据备份与恢复。" Style="{StaticResource Hint}" FontSize="12"/>
      <ContentControl Content="数据备份" Style="{StaticResource Section}"/><TextBlock Text="包含日常数据库、地图、通信配置和 Web 工程方案。后台与 Web 停止后可创建完整备份。" Style="{StaticResource Hint}"/><WrapPanel><Button Content="创建备份" Style="{StaticResource Primary}" Command="{Binding BackupCommand}"/><Button Content="打开备份目录" Command="{Binding OpenBackupCommand}"/></WrapPanel>
      <ContentControl Content="备份恢复" Style="{StaticResource Section}" Margin="0,30,0,16"/><TextBlock Text="校验同版本备份的清单、哈希及数据库后恢复，原数据另存保留。恢复后不自动启动或放行恢复屏障。" Style="{StaticResource Hint}"/><Button Content="选择备份并恢复…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
     <StackPanel Visibility="{Binding OverviewVisibility}">
      <ContentControl Content="软件信息" Style="{StaticResource Section}"/><TextBlock Text="AGV 软件助手" FontSize="23" Margin="0,10,0,15"/><TextBlock Text="{Binding Release}" Margin="0,0,0,18"/><TextBlock Text="本工具负责服务管理、配置检查、数据维护与日志诊断。调度业务统一在 Web 操作。" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Paths}" LineHeight="27" Margin="0,10,0,24"/><WrapPanel><Button Content="打开运行数据目录" Command="{Binding OpenDataCommand}"/><Button Content="打开前端 ↗" Command="{Binding OpenWebCommand}"/></WrapPanel><ContentControl Content="后台观察" Style="{StaticResource Section}" Margin="0,24,0,16"/><TextBlock Text="{Binding Runtime}" LineHeight="25"/>
     </StackPanel>
     <StackPanel Visibility="{Binding LogVisibility}">
      <ContentControl Content="日志管理" Style="{StaticResource Section}"/><WrapPanel><Button Content="读取最近日志" Command="{Binding ReadLogCommand}" Style="{StaticResource Primary}"/><Button Content="导出诊断包" Command="{Binding ExportCommand}"/><Button Content="打开诊断目录" Command="{Binding OpenDiagnosticCommand}"/></WrapPanel><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Height="285" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><ContentControl Content="本次管理操作" Style="{StaticResource Section}" Margin="0,20,0,16"/><TextBox Text="{Binding Journal, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto"/>
     </StackPanel>
     <StackPanel Visibility="{Binding NetworkVisibility}">
      <ContentControl Content="启动配置" Style="{StaticResource Section}"/><TextBlock Text="{Binding Policy}" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><TextBlock Text="最大并发任务数" VerticalAlignment="Center" Margin="0,0,20,8"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,8"/><Button Content="保存配置" Command="{Binding SavePolicyCommand}" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="停止系统后可保存，下次启动生效；保存前自动备份原配置。" Style="{StaticResource Hint}" FontSize="12"/>
      <ContentControl Content="网络配置与检查" Style="{StaticResource Section}" Margin="0,24,0,16"/><TextBlock Text="{Binding Network}" LineHeight="25" Margin="0,0,0,16"/><WrapPanel><Button Content="Windows 网络设置 ↗" Command="{Binding NetworkSettingsCommand}"/><Button Content="复制前端地址" Command="{Binding CopyUrlCommand}"/></WrapPanel><TextBlock Text="当前前端仅允许本机访问：http://127.0.0.1:5199/。修改电脑 IP 不会自动开放远程访问。" Style="{StaticResource Hint}" FontSize="12"/>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="100"/><ColumnDefinition Width="16"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProbeAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="目标 IP 地址"/><TextBox Grid.Column="2" Text="{Binding ProbePort, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口"/><Button Grid.Column="4" Content="测试连接" Command="{Binding ProbeCommand}" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid><TextBlock Text="{Binding ProbeResult}" Style="{StaticResource Hint}" FontSize="12"/>
      <ContentControl Content="设备通信配置" Style="{StaticResource Section}" Margin="0,24,0,16"/><TextBlock Text="{Binding ConnectionsState}" Style="{StaticResource Hint}" FontSize="12"/><Button Content="打开通信配置 ↗" Command="{Binding OpenEngineeringCommand}" HorizontalAlignment="Left"/>
      <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource Line}" RowHeight="40" MinHeight="50" MaxHeight="260" FontSize="12"><DataGrid.Columns><DataGridTextColumn Header="设备" Binding="{Binding Id}" Width="100"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="50"/><DataGridTextColumn Header="当前地址" Binding="{Binding ActiveEndpoint}" Width="145"/><DataGridTextColumn Header="已保存地址" Binding="{Binding SavedEndpoint}" Width="145"/><DataGridTextColumn Header="后台观察" Binding="{Binding State}" Width="*" MinWidth="150"/></DataGrid.Columns></DataGrid>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="11" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/><TextBlock Grid.Column="1" Text="{Binding LastCheck}" Foreground="{StaticResource Muted}" FontSize="11" Margin="15,0,0,0"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
