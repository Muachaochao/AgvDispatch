<Window x:Class="AgvDispatch.Wpf.Management.ManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AGV 软件助手" Width="1320" Height="840" MinWidth="1160" MinHeight="700"
 WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" Icon="/AgvDispatch.Wpf;component/Assets/Icons/AppIcon.ico">
 <Window.Resources>
  <Style x:Key="RowName" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="RowSub" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  <Style x:Key="Cell" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="RowLine" TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,12"/></Style>
  <Style x:Key="Metric" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="Padding" Value="18,16"/><Setter Property="MinHeight" Value="112"/></Style>
  <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,4"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="MetricDetail" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="MaxHeight" Value="32"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="SectionHead" TargetType="DockPanel"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="LastChildFill" Value="True"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- Navigation -->
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,26,18,18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,36">
     <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FC795B" Offset="0"/><GradientStop Color="#F7A150" Offset="1"/></LinearGradientBrush></Border.Background>
      <TextBlock Text="AGV" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="AGV 软件助手" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="现场服务 · 版本 · 诊断" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Canvas}" CornerRadius="8" Padding="12,10" Margin="0,20,0,0">
     <StackPanel>
      <TextBlock FontSize="11" Foreground="{StaticResource Muted}"><Run Text="助手 "/><Run Text="{Binding AssistantVersion, Mode=OneWay}"/></TextBlock>
      <TextBlock Text="{Binding Release}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,6"/>
      <TextBlock FontSize="11"><Hyperlink Command="{Binding OpenWebCommand}" Foreground="#3D6E9E" TextDecorations="None">127.0.0.1:5199 ↗</Hyperlink></TextBlock>
     </StackPanel>
    </Border>
    <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="#3A3F47"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Nav" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Foreground="#8F95A0" Margin="0,0,14,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border>
       <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="服务管理"><Setter TargetName="Glyph" Property="Text" Value="&#xE80F;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="版本与备份"><Setter TargetName="Glyph" Property="Text" Value="&#xE896;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="软件信息"><Setter TargetName="Glyph" Property="Text" Value="&#xE946;"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value="日志管理"><Setter TargetName="Glyph" Property="Text" Value="&#xE9D9;"/></DataTrigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#C2551A"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Glyph" Property="Foreground" Value="#F2863D"/><Setter TargetName="Nav" Property="Background" Value="{StaticResource BrandSoft}"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Nav" Property="Background" Value="#F2F3F5"/></MultiTrigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1" Margin="32,22,28,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- Page header -->
   <DockPanel Margin="0,0,0,18">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="刷新" Command="{Binding RefreshCommand}"/>
     <Button Content="打开前端 ↗" Command="{Binding OpenWebCommand}" Margin="0,0,0,8"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
    <StackPanel>

     <!-- ========== 服务管理 ========== -->
     <StackPanel Visibility="{Binding ServiceVisibility}">
      <UniformGrid Columns="4" Margin="0,0,-14,0">
       <Border Style="{StaticResource Metric}"><StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Tag="{Binding SystemLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding SystemHeadline}" FontSize="11"/></StackPanel></Border><TextBlock Text="调度系统" Style="{StaticResource MetricLabel}"/></DockPanel>
        <TextBlock Text="{Binding SystemHeadline}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="{Binding SystemDetail}" Style="{StaticResource MetricDetail}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Metric}"><StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Tag="{Binding PaiceLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding PaiceHeadline}" FontSize="11"/></StackPanel></Border><TextBlock Text="排策智演" Style="{StaticResource MetricLabel}"/></DockPanel>
        <TextBlock Text="{Binding PaiceHeadline}" Style="{StaticResource MetricValue}"/>
        <TextBlock Text="{Binding PaiceSimulationState}" Style="{StaticResource MetricDetail}" ToolTip="{Binding PaiceSimulationState}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Metric}"><StackPanel>
        <TextBlock Text="当前仿真方案" Style="{StaticResource MetricLabel}"/>
        <TextBlock Text="{Binding InstanceHeadline}" Style="{StaticResource MetricValue}" ToolTip="{Binding InstanceHeadline}"/>
        <TextBlock Text="{Binding InstanceDetail}" Style="{StaticResource MetricDetail}" ToolTip="{Binding CurrentIdentity}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Metric}"><StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Tag="{Binding BaselineLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="基线" FontSize="11"/></StackPanel></Border><TextBlock Text="现场测试基线" Style="{StaticResource MetricLabel}"/></DockPanel>
        <TextBlock Text="{Binding BaselineState}" Style="{StaticResource MetricValue}"/>
        <TextBlock Style="{StaticResource MetricDetail}"><Hyperlink Command="{Binding OpenBackupPageCommand}" Foreground="#3D6E9E" TextDecorations="None">查看与锁定 →</Hyperlink></TextBlock>
       </StackPanel></Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="18,14">
       <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="一键启动（系统＋排策智演）" Command="{Binding StartAllCommand}" IsEnabled="{Binding CanStartAll}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
         <Button Content="重启系统" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestartSystem}" Margin="0,0,8,0"/>
         <Button Content="停止系统" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopSystem}" Style="{StaticResource Danger}" Margin="0"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="现场测试快捷操作" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="一键启动按顺序拉起后台、Web 与排策智演；已运行的部分自动跳过。停止前核验任务、路权、充电与车辆停稳。" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
       </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel Style="{StaticResource SectionHead}">
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="启动" Command="{Binding StartCommand}" IsEnabled="{Binding CanStartSystem}" Style="{StaticResource Primary}"/>
          <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding CanStopSystem}" Style="{StaticResource Danger}"/>
          <Button Content="配置" Command="{Binding OpenSettingsCommand}" Margin="0,0,0,8"/>
         </StackPanel>
         <StackPanel><TextBlock Text="调度服务" Style="{StaticResource Title}" Margin="0"/><TextBlock Text="后台与 Web 由统一入口联动启停" Style="{StaticResource Hint}"/></StackPanel>
        </DockPanel>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="AgvDispatch.Service" Style="{StaticResource RowName}"/><TextBlock Text="调度后台 · PLC / AGV 通信" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding BackendLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding BackendConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="{Binding ServiceState}" Style="{StaticResource Cell}"/>
        </Grid></Border>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="AgvDispatch.WebHost" Style="{StaticResource RowName}"/><TextBlock Text="日常 Web · 127.0.0.1:5199" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding WebLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding WebConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="{Binding WebState}" Style="{StaticResource Cell}"/>
        </Grid></Border>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel Style="{StaticResource SectionHead}">
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="启动" Command="{Binding StartPaiceCommand}" IsEnabled="{Binding CanStartPaiceSimulation}" Style="{StaticResource Primary}" ToolTip="半运行时会先清理本工具记录的残留进程再启动"/>
          <Button Content="停止" Command="{Binding StopPaiceCommand}" IsEnabled="{Binding CanStopPaiceSimulation}" Style="{StaticResource Danger}"/>
          <Button Content="打开排策智演 ↗" Command="{Binding OpenPaiceCommand}" Margin="0,0,0,8"/>
         </StackPanel>
         <StackPanel><TextBlock Text="排策智演" Style="{StaticResource Title}" Margin="0"/><TextBlock Text="{Binding PaiceSimulationState}" Style="{StaticResource Hint}"/></StackPanel>
        </DockPanel>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="排策智演前端" Style="{StaticResource RowName}"/><TextBlock Text="127.0.0.1:5270" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding PaiceFrontendLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding PaiceFrontendConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="{Binding PaiceFrontendState}" Style="{StaticResource Cell}"/>
        </Grid></Border>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="排策智演后端" Style="{StaticResource RowName}"/><TextBlock Text="127.0.0.1:5271" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding PaiceBackendLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding PaiceBackendConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="{Binding PaiceBackendState}" Style="{StaticResource Cell}"/>
        </Grid></Border>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="数据服务" Style="{StaticResource Title}" Margin="0,0,0,6"/>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="SQLite 运行数据库" Style="{StaticResource RowName}"/><TextBlock Text="内嵌，随后台使用" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding DatabaseLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding DatabaseConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="{Binding DatabaseState}" Style="{StaticResource Cell}"/>
         <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="检查" Command="{Binding CheckDatabaseCommand}" Margin="0,0,8,0"/><Button Content="数据目录" Command="{Binding OpenDataCommand}" Margin="0,0,8,0"/><Button Content="备份" Command="{Binding OpenBackupPageCommand}" Margin="0"/></StackPanel>
        </Grid></Border>
        <Border Style="{StaticResource RowLine}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Web 工程方案库" Style="{StaticResource RowName}"/><TextBlock Text="本地文件存储" Style="{StaticResource RowSub}"/></StackPanel>
         <Border Grid.Column="1" Style="{StaticResource Pill}" Tag="{Binding ProjectLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding ProjectConnection}" FontSize="12"/></StackPanel></Border>
         <TextBlock Grid.Column="2" Text="运行数据/Web工程方案" Style="{StaticResource Cell}"/>
         <StackPanel Grid.Column="3" Orientation="Horizontal"><Button Content="配置 ↗" Command="{Binding OpenEngineeringCommand}" Margin="0,0,8,0"/><Button Content="备份" Command="{Binding OpenBackupPageCommand}" Margin="0"/></StackPanel>
        </Grid></Border>
       </StackPanel>
      </Border>

      <Expander Header="运行详情与调度诊断" Margin="2,0,0,16" Foreground="#5B616B"><Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding Runtime}" LineHeight="22" FontSize="12"/><WrapPanel Margin="0,12,0,0"><Button Content="六层调度监控 ↗" Command="{Binding OpenPipelineCommand}"/><Button Content="异常恢复 ↗" Command="{Binding OpenRecoveryCommand}"/></WrapPanel></StackPanel></Border></Expander>
     </StackPanel>

     <!-- ========== 版本与备份 ========== -->
     <StackPanel Visibility="{Binding BackupVisibility}">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Tag="{Binding BaselineLevel}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource Dot}"/><TextBlock Text="{Binding BaselineState}" FontSize="12"/></StackPanel></Border><TextBlock Text="现场测试基线" Style="{StaticResource Title}" Margin="0"/></DockPanel>
        <TextBlock Text="把“发布版本 + 仿真方案 + 地图摘要 + PLC 点表 + 倍率”锁定为一次现场测试的基线。之后任何一项变化都会在这里和首页提示；仿真实例每次干净配置都会更新，方案与地图不变时只作提示，不算变化。" Style="{StaticResource Hint}"/>
        <Grid Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="14,12"><StackPanel><TextBlock Text="当前" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{Binding CurrentIdentity}" LineHeight="22" FontSize="12"/></StackPanel></Border>
         <Border Grid.Column="2" Background="{StaticResource Canvas}" CornerRadius="8" Padding="14,12"><StackPanel><TextBlock Text="与基线比较" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{Binding BaselineDetail}" LineHeight="22" FontSize="12"/></StackPanel></Border>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox Text="{Binding BaselineNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="基线备注，例如：B07 V4F 五车十单 现场联调 第1轮" Margin="0,0,12,8"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="锁定为基线" Command="{Binding LockBaselineCommand}" Style="{StaticResource Primary}"/><Button Content="导出版本档案" Command="{Binding ExportRecordCommand}" Margin="0,0,0,8"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前发布版本" Style="{StaticResource Title}"/><TextBlock Text="{Binding Release}" FontSize="17" Margin="0,0,0,8"/><TextBlock Text="{Binding Paths}" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="排策智演方案与地图" Style="{StaticResource Title}"/><TextBlock Text="{Binding PaiceSimulationSummary}" Style="{StaticResource Hint}" LineHeight="22"/><Button Content="打开工程与地图 ↗" Command="{Binding OpenPaiceEngineeringCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据备份" Style="{StaticResource Title}"/><TextBlock Text="包含日常数据库、地图、通信配置和 Web 工程方案。后台与 Web 停止后可创建完整备份。" Style="{StaticResource Hint}"/><WrapPanel><Button Content="创建备份" Style="{StaticResource Primary}" Command="{Binding BackupCommand}"/><Button Content="打开备份目录" Command="{Binding OpenBackupCommand}"/></WrapPanel></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="备份恢复" Style="{StaticResource Title}"/><TextBlock Text="校验同版本备份的清单、哈希及数据库后恢复，原数据另存保留。恢复后不自动启动或放行恢复屏障。" Style="{StaticResource Hint}"/><Button Content="选择备份并恢复…" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
      </Grid>
     </StackPanel>

     <!-- ========== 软件信息 ========== -->
     <StackPanel Visibility="{Binding OverviewVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AGV 软件助手" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{Binding Release}" Margin="0,0,0,12"/><TextBlock Text="本工具负责服务管理、版本基线、数据维护与日志诊断。调度业务统一在 Web 操作。" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Paths}" LineHeight="24" Margin="0,4,0,14"/><WrapPanel><Button Content="打开运行数据目录" Command="{Binding OpenDataCommand}"/><Button Content="打开前端 ↗" Command="{Binding OpenWebCommand}"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="后台观察" Style="{StaticResource Title}"/><TextBlock Text="{Binding Runtime}" LineHeight="24"/></StackPanel></Border>
     </StackPanel>

     <!-- ========== 日志管理 ========== -->
     <StackPanel Visibility="{Binding LogVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,8"><WrapPanel DockPanel.Dock="Right"><Button Content="读取最近日志" Command="{Binding ReadLogCommand}" Style="{StaticResource Primary}"/><Button Content="导出诊断包" Command="{Binding ExportCommand}"/><Button Content="打开诊断目录" Command="{Binding OpenDiagnosticCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="后台日志" Style="{StaticResource Title}"/></DockPanel>
       <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Height="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFBFC"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本次管理操作" Style="{StaticResource Title}"/><TextBox Text="{Binding Journal, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" Background="#FAFBFC"/></StackPanel></Border>
     </StackPanel>

     <!-- ========== 系统设置 ========== -->
     <StackPanel Visibility="{Binding NetworkVisibility}">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="启动配置" Style="{StaticResource Title}"/><TextBlock Text="{Binding Policy}" Style="{StaticResource Hint}"/><StackPanel Orientation="Horizontal"><TextBlock Text="最大并发任务数" VerticalAlignment="Center" Margin="0,0,16,8"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,12,8"/><Button Content="保存配置" Command="{Binding SavePolicyCommand}" Style="{StaticResource Primary}"/></StackPanel><TextBlock Text="停止系统后可保存，下次启动生效；保存前自动备份原配置。" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="网络配置与检查" Style="{StaticResource Title}"/><TextBlock Text="{Binding Network}" LineHeight="24" Margin="0,0,0,12" FontFamily="Consolas, Microsoft YaHei UI"/><WrapPanel><Button Content="Windows 网络设置 ↗" Command="{Binding NetworkSettingsCommand}"/><Button Content="复制前端地址" Command="{Binding CopyUrlCommand}"/></WrapPanel><TextBlock Text="当前前端仅允许本机访问：http://127.0.0.1:5199/。修改电脑 IP 不会自动开放远程访问。" Style="{StaticResource Hint}"/>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProbeAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="目标 IP 地址"/><TextBox Grid.Column="2" Text="{Binding ProbePort, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口"/><Button Grid.Column="4" Content="测试连接" Command="{Binding ProbeCommand}" VerticalAlignment="Top" Margin="0"/></Grid><TextBlock Text="{Binding ProbeResult}" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="打开通信配置 ↗" Command="{Binding OpenEngineeringCommand}" Margin="0"/><TextBlock Text="设备通信配置" Style="{StaticResource Title}"/></DockPanel><TextBlock Text="{Binding ConnectionsState}" Style="{StaticResource Hint}"/>
       <DataGrid ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}" BorderBrush="{StaticResource Line}" Background="White" RowHeight="38" MinHeight="50" MaxHeight="300" FontSize="12"><DataGrid.Columns><DataGridTextColumn Header="设备" Binding="{Binding Id}" Width="110"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="56"/><DataGridTextColumn Header="当前地址" Binding="{Binding ActiveEndpoint}" Width="150"/><DataGridTextColumn Header="已保存地址" Binding="{Binding SavedEndpoint}" Width="150"/><DataGridTextColumn Header="后台观察" Binding="{Binding State}" Width="*" MinWidth="150"/></DataGrid.Columns></DataGrid></StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>

   <!-- Status bar -->
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Message}" Foreground="#4A5059" FontSize="12" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/><TextBlock Grid.Column="1" Text="{Binding LastCheck}" Foreground="{StaticResource Muted}" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
