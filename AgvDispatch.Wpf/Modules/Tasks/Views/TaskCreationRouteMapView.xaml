<UserControl x:Class="AgvDispatch.Wpf.Views.TaskCreationRouteMapView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <WrapPanel><Button Content="定位首个不符段" Command="{Binding LocateFailedCreationRouteCommand}" Padding="10,5"/><Button Content="全图" Command="{Binding FitCreationRouteMapCommand}" Padding="10,5" Margin="6,0"/><Button Content="＋" Command="{Binding ZoomInCreationRouteMapCommand}" Padding="10,5"/><Button Content="－" Command="{Binding ZoomOutCreationRouteMapCommand}" Padding="10,5" Margin="6,0"/></WrapPanel>
  <ScrollViewer Grid.Row="1" MaxHeight="92" VerticalScrollBarVisibility="Auto" Margin="0,5"><TextBlock Text="{Binding CreationRouteMapMessage}" TextWrapping="Wrap"/></ScrollViewer>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0"><StackPanel><TextBlock Text="车辆动作与PLC条件" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="{Binding CreationRouteActionDetails}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
  <Border Background="{DynamicResource MutedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
   <Viewbox Stretch="Uniform"><Canvas Width="900" Height="500" ClipToBounds="True">
    <Canvas Width="900" Height="500"><Canvas.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding CreationMapZoom}" ScaleY="{Binding CreationMapZoom}" CenterX="450" CenterY="250"/><TranslateTransform X="{Binding CreationMapPanX}" Y="{Binding CreationMapPanY}"/></TransformGroup></Canvas.RenderTransform>
     <ItemsControl ItemsSource="{Binding CreationMapRoads}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Path Data="{Binding Geometry}" Stroke="#7D91AA" StrokeThickness="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Path Data="{Binding CreationMapSelectedGeometry}" Stroke="#FFD34D" StrokeThickness="12" IsHitTestVisible="False"/>
     <ItemsControl ItemsSource="{Binding CreationMapRoutes}" Width="900" Height="500"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas Width="900" Height="500">
      <Path Data="{Binding Geometry}" Stroke="Transparent" StrokeThickness="14" Cursor="Hand" ToolTip="{Binding Tooltip}" MouseLeftButtonDown="RouteClick"/>
      <Path Data="{Binding Geometry}" Stroke="{Binding Color}" StrokeThickness="5" IsHitTestVisible="False"/>
      <Path Data="{Binding Arrow}" Fill="{Binding Color}" Stroke="{DynamicResource MutedSurfaceBrush}" StrokeThickness="0.8" IsHitTestVisible="False"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SelectedCreationRouteSegment,RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
     </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Path Data="{Binding CreationMapSelectedArrow}" Fill="#FFD34D" Stroke="#192A3B" StrokeThickness="0.8" IsHitTestVisible="False"/>
     <ItemsControl ItemsSource="{Binding CreationMapDots}" Width="900" Height="500"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="10" Height="10" Fill="#279BF1" Stroke="White" StrokeThickness="1" ToolTip="{Binding Tooltip}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Canvas>
   </Canvas></Viewbox>
  </Border>
  </Grid>
 </Grid>
</UserControl>
