<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AgvDispatch.Wpf.NewMapWindow" Title="新建地图" Width="520" Height="620" ResizeMode="CanResize" MinWidth="480" MinHeight="540" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="创建独立地图" FontSize="20" FontWeight="SemiBold" />
   <TextBlock Text="在空白网格上创建站点、节点与路径，每张地图独立保存图层和版本。" Margin="0,8,0,20" TextWrapping="Wrap" />
   <TextBlock Text="地图名称 *" /><TextBox x:Name="NameBox" Margin="0,5,0,12" Height="32" />
   <TextBlock Text="说明（可选）" /><TextBox x:Name="DescriptionBox" Margin="0,5,0,12" Height="32" />
   <Expander Header="参考CAD底图（可选；一般无需导入）" Margin="0,6,0,12"><StackPanel><TextBlock Text="CAD文件（可选；留空从空白地图开始）" />
   <DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择…" Click="Browse_OnClick" Padding="12,5" Margin="6,0,0,0" /><TextBox x:Name="BackgroundBox" Height="32" /></DockPanel>
   <TextBlock Text="参考底图坐标单位" />
   <ComboBox x:Name="UnitBox" SelectedIndex="0" Height="32" Margin="0,5,0,8">
    <ComboBoxItem Content="米（1 CAD单位 = 1米）" Tag="m" />
    <ComboBoxItem Content="毫米（1 CAD单位 = 0.001米）" Tag="mm" />
    <ComboBoxItem Content="厘米（1 CAD单位 = 0.01米）" Tag="cm" />
   </ComboBox>
   <TextBlock Text="CAD仅作为底图，导航点线需另行绘制。离线时本地读取；在线上传后须确认后台也能读取CAD源文件。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
   <TextBlock Text="{Binding MapConnectionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
   </StackPanel></Expander><TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
   <Button Content="取消" IsCancel="True" Padding="20,7" Margin="0,0,8,0" />
   <Button x:Name="CreateButton" Style="{StaticResource AppPrimaryButtonStyle}" Content="创建地图" IsDefault="True" Click="Create_OnClick" Padding="20,7" />
  </StackPanel>
 </Grid>
</Window>
