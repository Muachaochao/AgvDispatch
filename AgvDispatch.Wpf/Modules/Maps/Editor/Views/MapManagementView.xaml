          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding CalibrationText}" FontWeight="SemiBold" />
              <TextBlock Text="至少输入2个CAD坐标→地图坐标控制点；建议3个以上，用RMS误差检查标定质量。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="增加控制点" Command="{Binding AddCalibrationPointCommand}" Padding="12,6" Margin="0,0,8,0" />
              <Button Content="删除控制点" Command="{Binding RemoveCalibrationPointCommand}" Padding="12,6" Margin="0,0,8,0" />
              <Button Content="计算并保存标定" Command="{Binding SaveCalibrationCommand}" Padding="12,6" Background="#FF287A50" Foreground="White" />
            </StackPanel>
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding CalibrationPoints}" SelectedItem="{Binding SelectedCalibrationPoint}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="CAD X" Binding="{Binding CadX}" Width="*" />
              <DataGridTextColumn Header="CAD Y" Binding="{Binding CadY}" Width="*" />
              <DataGridTextColumn Header="地图 X（米）" Binding="{Binding MapX}" Width="*" />
              <DataGridTextColumn Header="地图 Y（米）" Binding="{Binding MapY}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="实时车辆" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="10,8">
