            <Button Content="播放" Command="{Binding PlayTrackReplayCommand}" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="暂停" Command="{Binding PauseTrackReplayCommand}" Padding="10,4" Margin="0,0,6,0" />
            <Button Content="清除" Command="{Binding ClearTrackReplayCommand}" Padding="10,4" Margin="0,0,12,0" />
            <TextBlock Text="{Binding ReplaySummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding LiveAgvs}" SelectedItem="{Binding SelectedLiveAgv}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="车辆" Binding="{Binding DisplayName}" Width="100" />
              <DataGridTextColumn Header="车辆ID" Binding="{Binding VehicleId}" Width="110" />
              <DataGridTextColumn Header="连接" Binding="{Binding Connection}" Width="90" />
              <DataGridTextColumn Header="X(m)" Binding="{Binding X, StringFormat=F2}" Width="75" />
              <DataGridTextColumn Header="Y(m)" Binding="{Binding Y, StringFormat=F2}" Width="75" />
              <DataGridTextColumn Header="角度" Binding="{Binding Angle, StringFormat=F1}" Width="70" />
              <DataGridTextColumn Header="定位置信度" Binding="{Binding LocalizationConfidence, StringFormat=P0}" Width="100" />
              <DataGridTextColumn Header="地图判定" Binding="{Binding MapPositionState}" Width="105" />
              <DataGridTextColumn Header="最近路段" Binding="{Binding NearestEdgeId}" Width="100" />
              <DataGridTextColumn Header="偏差(m)" Binding="{Binding DistanceToRouteMeters, StringFormat=F2}" Width="80" />
              <DataGridTextColumn Header="电量(%)" Binding="{Binding BatteryPercent, StringFormat=F0}" Width="80" />
              <DataGridTextColumn Header="诊断原因" Binding="{Binding MapPositionMessage}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="地图校验" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="校验当前编辑区" Command="{Binding ValidateLocalCommand}" HorizontalAlignment="Left" Margin="8" ToolTip="本地检查拓扑，无需调度服务" />
        <DataGrid ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="100" />
            <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="170" />
            <DataGridTextColumn Header="问题说明" Binding="{Binding Message}" Width="*" />
            <DataGridTextColumn Header="对象" Binding="{Binding ObjectIds}" Width="220" />
          </DataGrid.Columns>
        </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="路径仿真" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="起点" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Nodes}" DisplayMemberPath="Id" SelectedValuePath="Id" SelectedValue="{Binding SimulationSource, UpdateSourceTrigger=PropertyChanged}">
</ComboBox>
            <TextBlock Grid.Column="3" Text="终点" VerticalAlignment="Center" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Nodes}" DisplayMemberPath="Id" SelectedValuePath="Id" SelectedValue="{Binding SimulationDestination, UpdateSourceTrigger=PropertyChanged}">
</ComboBox>
            <TextBlock Grid.Column="6" Text="模拟封锁资源" VerticalAlignment="Center" />
            <TextBox Grid.Column="7" Text="{Binding SimulationBlockedResources, UpdateSourceTrigger=PropertyChanged}" ToolTip="多个资源ID使用分号分隔，例如 NARROW-01;CROSS-02" />
            <Button Grid.Column="8" Content="计算路径" Command="{Binding SimulateRouteCommand}" Padding="18,7" Margin="10,0,0,0" Background="#FF245E78" Foreground="White" />
          </Grid>
          <Border Grid.Row="1" Margin="0,10,0,8" Padding="10" CornerRadius="5" Background="{DynamicResource AccentMutedBrush}">
            <TextBlock Text="{Binding SimulationResult}" TextWrapping="Wrap" />
          </Border>
          <DataGrid Grid.Row="2" ItemsSource="{Binding SimulationSteps}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="顺序" Binding="{Binding Sequence}" Width="80" />
              <DataGridTextColumn Header="业务节点ID" Binding="{Binding LogicalNodeId}" Width="*" />
              <DataGridTextColumn Header="Robokit站点ID（实际下发）" Binding="{Binding AgvSiteId}" Width="*" />
              <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" Width="160" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="发布前检查" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding PreflightSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="逐对检查所有启用的工位、等待点和充电点；失败项全部展示，通过项最多展示200条样例。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="运行全站点检查" Command="{Binding RunPreflightCommand}" Padding="18,7" Background="#FF287A50" Foreground="White" Margin="12,0,0,0" />
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding PreflightEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="起点" Binding="{Binding Source}" Width="150" />
              <DataGridTextColumn Header="终点" Binding="{Binding Destination}" Width="150" />
              <DataGridCheckBoxColumn Header="可达" Binding="{Binding Reachable}" Width="70" />
              <DataGridTextColumn Header="成本" Binding="{Binding Cost, StringFormat=F3}" Width="90" />
              <DataGridTextColumn Header="路段数" Binding="{Binding EdgeCount}" Width="80" />
              <DataGridTextColumn Header="占用资源" Binding="{Binding ResourceText}" Width="220" />
              <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="版本差异" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding VersionDiffSummary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="重新比较" Command="{Binding CompareVersionsCommand}" Padding="18,7" Margin="12,0,0,0" />
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding VersionDifferences}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="对象类型" Binding="{Binding ObjectType}" Width="130" />
              <DataGridTextColumn Header="对象ID" Binding="{Binding ObjectId}" Width="220" />
              <DataGridTextColumn Header="变化" Binding="{Binding Kind}" Width="110" />
              <DataGridTextColumn Header="说明" Binding="{Binding Details}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="操作审计" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <TextBlock Text="最近300条地图操作由Windows Service持久化记录。" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="刷新审计" Command="{Binding RefreshMapAuditsCommand}" Padding="16,7" HorizontalAlignment="Right" />
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding MapAudits}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding OccurredAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165" />
              <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="135" />
              <DataGridCheckBoxColumn Header="成功" Binding="{Binding Success}" Width="65" />
              <DataGridTextColumn Header="操作账号" Binding="{Binding OperatorIdentity}" Width="190" />
              <DataGridTextColumn Header="版本ID" Binding="{Binding VersionId}" Width="190" />
              <DataGridTextColumn Header="摘要" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <TextBlock Text="版本历史/恢复" Foreground="{DynamicResource TextPrimaryBrush}" />
        </TabItem.Header>
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.4*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
              <TextBlock Text="数据库版本历史" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="刷新版本" Command="{Binding RefreshVersionHistoryCommand}" Padding="14,6" HorizontalAlignment="Right" />
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding VersionHistory}" SelectedItem="{Binding SelectedHistoryVersion}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="版本" Binding="{Binding VersionNumber, StringFormat=V{0}}" Width="70" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95" />
                <DataGridTextColumn Header="节点" Binding="{Binding NodeCount}" Width="65" />
                <DataGridTextColumn Header="路段" Binding="{Binding EdgeCount}" Width="65" />
                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCount}" Width="65" />
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="165" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="预览版本" Command="{Binding PreviewHistoryVersionCommand}" Padding="14,6" Margin="0,0,8,0" />
              <Button Content="加载到编辑区" Command="{Binding RestoreHistoryToEditorCommand}" Padding="14,6" Background="#FFC87A18" Foreground="White" ToolTip="只替换本地编辑区，可撤销；不会直接写数据库" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,8" Padding="10" CornerRadius="5" Background="{DynamicResource AccentMutedBrush}">
              <TextBlock Text="{Binding HistoryPreviewSummary}" TextWrapping="Wrap" />
            </Border>
            <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryPreviewDifferences}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="对象" Binding="{Binding ObjectType}" Width="100" />
                <DataGridTextColumn Header="ID" Binding="{Binding ObjectId}" Width="180" />
                <DataGridTextColumn Header="变化" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="说明" Binding="{Binding Details}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#D8E1EC" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="当前层" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox ItemsSource="{Binding MapLayers}" SelectedItem="{Binding CurrentLayer}" DisplayMemberPath="Name" Width="120" Height="25" /></StackPanel><TextBlock Text="{Binding PointerText}" FontFamily="Consolas" Foreground="#475569" Margin="10,0" />
          <TextBlock Text="{Binding CanvasViewText}" Foreground="#475569" Margin="10,0" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" FontSize="11" Foreground="#1D4ED8" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding WorkbenchHint}" ToolTip="{Binding WorkbenchHint}" FontSize="10" Foreground="#475569" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
