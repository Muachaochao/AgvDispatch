<UserControl x:Class="AgvDispatch.Wpf.Views.PointCloudView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel>
   <Button Content="打开点云文件" Click="Open_OnClick" Padding="12,6"/><Button Content="适合视图" Click="Fit_OnClick" Margin="8,0" Padding="12,6"/><Button Content="俯视" Click="Top_OnClick" Padding="12,6"/>
   <TextBlock Text="高度范围(m)" Margin="18,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
   <TextBox x:Name="MinHeightBox" AutomationProperties.Name="切片最低高度，单位米" Width="90" VerticalContentAlignment="Center"/><TextBlock Text=" ～ " VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBox x:Name="MaxHeightBox" AutomationProperties.Name="切片最高高度，单位米" Width="90" VerticalContentAlignment="Center"/>
   <Button Content="应用切片" Click="Slice_OnClick" Margin="8,0" Padding="12,6"/><Button Content="全部高度" Click="All_OnClick" Padding="12,6"/>
  </WrapPanel>
  <Border Grid.Row="1" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="5" Padding="10" Margin="0,12"><StackPanel>
   <TextBlock Text="三维点云只读查看 · 支持Robokit普通点云/XYZ；特征地图未渲染，坐标对齐与实车关联未核定。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
   <TextBlock x:Name="SourceText" Text="打开3D.smap包、.3dsmap或XYZ后可旋转、缩放、查看高度和选点；不会修改地图或连接车辆。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <Border x:Name="ViewportBorder" Grid.Row="2" Background="#101C30" BorderBrush="#34445A" BorderThickness="1" CornerRadius="5">
   <Grid>
    <Viewport3D x:Name="Viewport" ClipToBounds="True" MouseDown="Viewport_OnMouseDown" MouseMove="Viewport_OnMouseMove" MouseUp="Viewport_OnMouseUp" MouseWheel="Viewport_OnMouseWheel" LostMouseCapture="Viewport_OnLostCapture"/>
    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D0203048" Padding="10,6" Margin="12" IsHitTestVisible="False"><TextBlock Text="左键拖动旋转 · 右键拖动平移 · 滚轮缩放 · 单击点查看原始坐标" Foreground="#E6EDF7" TextWrapping="Wrap"/></Border>
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16" IsHitTestVisible="False"><TextBlock Text="高度颜色：低 → 高" Foreground="#E6EDF7"/><Rectangle Width="170" Height="12" Margin="0,5"><Rectangle.Fill><LinearGradientBrush><GradientStop Offset="0" Color="#3179ED"/><GradientStop Offset="0.5" Color="#34C7AE"/><GradientStop Offset="1" Color="#F8CB50"/></LinearGradientBrush></Rectangle.Fill></Rectangle></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock x:Name="StatusText" Text="尚未加载点云。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="PointText" Text="未选择点；选点只对当前显示的采样点有效。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 </Grid>
</UserControl>
