<UserControl x:Class="AgvDispatch.Wpf.Views.DashboardView"
    Foreground="{DynamicResource TextPrimaryBrush}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="clr-namespace:AgvDispatch.Wpf.Converters"
 xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="PanelVisibility"/>
  <converters:TaskLabelConverter x:Key="TaskLabel"/>
  <Style x:Key="ParameterLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,14,0,5"/><Setter Property="FontSize" Value="12"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="4*" MinHeight="280"/><RowDefinition Height="12"/><RowDefinition Height="*" MinHeight="140" MaxHeight="180"/>
  </Grid.RowDefinitions>
  <Border x:Name="RuntimeMapModule" Background="#101E2B" BorderBrush="#2C4356" BorderThickness="1" CornerRadius="12" Padding="16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="运行地图" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MapTitle}" Foreground="#ADC7D8" FontSize="12" Margin="0,5,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MapTitle}"/>
     </StackPanel>
     <ToggleButton x:Name="AgvPanelToggle" Grid.Column="1" IsChecked="{Binding IsAgvPanelOpen, Mode=TwoWay}" Padding="14,9" VerticalAlignment="Center"
      Background="#203D50" Foreground="White" BorderBrush="#36576C" Cursor="Hand" ToolTip="展开或收起地图右侧在线车辆信息" AutomationProperties.Name="在线 AGV 信息面板">
      <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="查看在线 AGV"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
         <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#2D5268"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#2D5268"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="#9FE7F7"/><Setter TargetName="ToggleSurface" Property="BorderThickness" Value="2"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="收起车辆面板"/></Trigger></Style.Triggers>
      </Style></ToggleButton.Style>
     </ToggleButton>
     <ItemsControl x:Name="OverviewMetrics" Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Metrics}" Margin="0,16,0,0">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#2C4356" BorderThickness="0,1,0,0" Padding="0,10,12,0" ToolTip="{Binding Detail}">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="{Binding Label}" Foreground="#ADC7D8" FontSize="12" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding Value}" Foreground="White" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="23" FontWeight="SemiBold" Margin="14,0,0,0"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,10">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition">
       <Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsAgvPanelOpen}" Value="True"><Setter Property="Width" Value="320"/></DataTrigger></Style.Triggers>
      </Style></ColumnDefinition.Style></ColumnDefinition>
     </Grid.ColumnDefinitions>
     <Grid x:Name="MapViewport" Background="#132633">
      <Viewbox  Stretch="Uniform" Margin="0,6,0,4">
       <Canvas Width="900" Height="520" Background="#132633" ClipToBounds="True">
        <ItemsControl ItemsSource="{Binding Map.Edges}" IsHitTestVisible="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Map.Nodes}" IsHitTestVisible="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
         <ItemsControl.ItemTemplate><DataTemplate><StackPanel><Ellipse Width="12" Height="12" Fill="{Binding Fill}"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="#ADC7D8" Margin="-5,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Map.Vehicles}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
         <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Opacity="{Binding Opacity}">
           <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding Label}"
            Command="{Binding DataContext.SelectVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding VehicleId}">
            <Grid Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
             <Grid.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Grid.RenderTransform>
             <Rectangle Width="31" Height="23" RadiusX="6" RadiusY="6" Fill="{Binding Fill}" Stroke="White" StrokeThickness="2"/>
             <Path Data="M 25,12 L 32,18 L 25,24" Stroke="#102A38" StrokeThickness="3"/>
            </Grid>
           </Button>
           <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="-5,4,-50,0"/>
          </StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </Canvas>
      </Viewbox>
      <Border x:Name="MapEmptyState" Background="#132633" Padding="20" IsHitTestVisible="False">
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Map.Nodes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="暂无可显示的运行地图" Foreground="White" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding MapTitle}" Foreground="#ADC7D8" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock Foreground="#ADC7D8" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="请在地图管理中检查运行地图及版本。"/><Style.Triggers><DataTrigger Binding="{Binding IsStatusAvailable}" Value="False"><Setter Property="Text" Value="后台连接恢复后将自动加载。"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </Grid>
     <Border x:Name="OnlineAgvPanel" Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1" CornerRadius="9" Padding="14" Visibility="{Binding IsAgvPanelOpen, Converter={StaticResource PanelVisibility}}">
      <Grid>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MaxHeight="150"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding OnlineVehicleText}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <ListBox Grid.Row="1" ItemsSource="{Binding OnlineVehicles}" SelectedItem="{Binding SelectedVehicle}" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="在线车辆列表">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,7"/><Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="VehicleRow" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="VehicleRow" Property="Background" Value="{DynamicResource MutedSurfaceBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="VehicleRow" Property="Background" Value="{DynamicResource AccentMutedBrush}"/><Setter TargetName="VehicleRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="VehicleRow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Ellipse Width="7" Height="7" Fill="{Binding Color}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding VehicleId}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Battery}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer x:Name="VehicleDetailsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
       <StackPanel DataContext="{Binding SelectedVehicle}">
        <Border Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="7" Padding="10"><StackPanel>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Connection}" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding Endpoint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <UniformGrid Columns="2">
         <StackPanel><TextBlock Text="电池电量" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Battery}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
         <StackPanel><TextBlock Text="定位置信度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Confidence}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="位置 / 朝向" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Coordinates}"/><TextBlock Text="{Binding Heading}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="当前站点 / 导航状态" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Station}"/><TextBlock Text="{Binding Navigation}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="车端任务 / 报警" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Tasks}"/>
        <TextBlock Text="速度 / 角速度" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Speed}"/><TextBlock Text="{Binding AngularSpeed}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="充电 / 电压 / 电流 / 温度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Charging}"/><TextBlock Text="{Binding BatteryDetails}" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Safety}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="最近成功心跳 / 响应" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Heartbeat}"/><TextBlock Text="{Binding Response}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="{Binding Position}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
      <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,32,0,0">
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding OnlineVehicles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></Border.Style>
       <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="当前没有在线 AGV&#10;请在通信设置 / 通信诊断中检查连接。"/><Style.Triggers><DataTrigger Binding="{Binding IsStatusAvailable}" Value="False"><Setter Property="Text" Value="后台连接暂不可用&#10;连接恢复后自动更新车辆信息。"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Border>
      </Grid>
     </Border>
    </Grid>
    <StackPanel Grid.Row="2">
     <TextBlock Text="绿：在线　黄：阻挡 / 定位异常　红：报警 / 急停　灰：离线旧位置" Foreground="#ADC7D8" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding UpdateText}" Foreground="#ADC7D8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="CurrentTasksModule" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><TextBlock Text="当前业务任务" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ActiveTasks.Count, StringFormat= · {0} 条}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Visibility="{Binding IsStatusAvailable, Converter={StaticResource PanelVisibility}}"/>
     </DockPanel>
     <DataGrid x:Name="ActiveTasksGrid" Grid.Row="1" Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding ActiveTasks}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" AutomationProperties.Name="当前业务任务" CanUserResizeRows="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
       <DataGridTextColumn Header="任务编号" Binding="{Binding TaskId}" Width="2*" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="*" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="*" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="执行阶段" Binding="{Binding Stage, Converter={StaticResource TaskLabel}}" Width="*" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat={}{0:HH:mm:ss}}" Width="*" ElementStyle="{StaticResource AppGridTextStyle}"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border x:Name="TaskEmptyState" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="12" IsHitTestVisible="False">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActiveTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="{Binding TaskEmptyMessage}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
     </Border>
    </Grid>
  </Border>
 </Grid>
</UserControl>
