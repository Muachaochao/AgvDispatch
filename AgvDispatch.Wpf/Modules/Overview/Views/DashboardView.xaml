<UserControl x:Class="AgvDispatch.Wpf.Views.DashboardView"
    Foreground="{DynamicResource TextPrimaryBrush}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" FontSize="13">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="PanelVisibility"/>
  <Style x:Key="ParameterLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,12,0,5"/><Setter Property="FontSize" Value="11"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="*" MinHeight="280"/><RowDefinition Height="12"/><RowDefinition Height="180" MinHeight="140"/>
  </Grid.RowDefinitions>
  <Border x:Name="RuntimeMapModule" Background="#101E2B" BorderBrush="#2C4356" BorderThickness="1" CornerRadius="12" Padding="16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="运行地图" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding MapTitle}" Foreground="#98B3C7" FontSize="11" Margin="0,5,12,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <ToggleButton x:Name="AgvPanelToggle" Grid.Column="1" IsChecked="{Binding IsAgvPanelOpen, Mode=TwoWay}" Padding="14,9" VerticalAlignment="Center"
      Background="#203D50" Foreground="White" BorderBrush="#36576C" Cursor="Hand" ToolTip="展开或收起地图右侧在线车辆信息">
      <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="◀ 在线 AGV"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
         <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#2D5268"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="#2D5268"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="收起 AGV ▶"/></Trigger></Style.Triggers>
      </Style></ToggleButton.Style>
     </ToggleButton>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,10">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition">
       <Setter Property="Width" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsAgvPanelOpen}" Value="True"><Setter Property="Width" Value="320"/></DataTrigger></Style.Triggers>
      </Style></ColumnDefinition.Style></ColumnDefinition>
     </Grid.ColumnDefinitions>
     <Grid x:Name="MapViewport">
      <Viewbox  Stretch="Uniform" Margin="0,6,0,4">
       <Canvas Width="900" Height="520" Background="#132633" ClipToBounds="True">
        <ItemsControl ItemsSource="{Binding Map.Edges}" IsHitTestVisible="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Map.Nodes}" IsHitTestVisible="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
         <ItemsControl.ItemTemplate><DataTemplate><StackPanel><Ellipse Width="12" Height="12" Fill="{Binding Fill}"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="#ADC7D8" Margin="-5,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Map.Vehicles}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
         <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Opacity="{Binding Opacity}">
           <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{Binding Tooltip}"
            Command="{Binding DataContext.SelectVehicleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding VehicleId}">
            <Grid Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
             <Grid.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Grid.RenderTransform>
             <Rectangle Width="31" Height="23" RadiusX="6" RadiusY="6" Fill="{Binding Fill}" Stroke="White" StrokeThickness="2"/>
             <Path Data="M 25,12 L 32,18 L 25,24" Stroke="#102A38" StrokeThickness="3"/>
            </Grid>
           </Button>
           <TextBlock Text="{Binding Label}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="-5,4,-50,0"/>
          </StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="运行地图暂无可显示的点线" Foreground="#98B3C7" FontSize="20" Canvas.Left="300" Canvas.Top="245" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Map.Nodes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Canvas>
      </Viewbox>
     </Grid>
     <Border x:Name="OnlineAgvPanel" Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1" CornerRadius="9" Padding="14" Visibility="{Binding IsAgvPanelOpen, Converter={StaticResource PanelVisibility}}">
      <Grid>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding OnlineVehicleText}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <ListBox Grid.Row="1" ItemsSource="{Binding OnlineVehicles}" SelectedItem="{Binding SelectedVehicle}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Width="235" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Ellipse Width="7" Height="7" Fill="{Binding Color}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VehicleId}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Battery}" Foreground="{Binding Color}" Margin="8,0,0,0"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
       <StackPanel DataContext="{Binding SelectedVehicle}">
        <Border Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="7" Padding="10"><StackPanel>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Connection}" Foreground="{Binding Color}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel></Border>
        <UniformGrid Columns="2">
         <StackPanel><TextBlock Text="电池电量" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Battery}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
         <StackPanel><TextBlock Text="定位置信度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Confidence}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="位置 / 朝向" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Coordinates}"/><TextBlock Text="{Binding Heading}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="当前站点 / 导航状态" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Station}"/><TextBlock Text="{Binding Navigation}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="车端任务 / 报警" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Tasks}"/>
        <TextBlock Text="速度 / 角速度" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Speed}"/><TextBlock Text="{Binding AngularSpeed}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="充电 / 电压 / 电流 / 温度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Charging}"/><TextBlock Text="{Binding BatteryDetails}" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding Safety}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="最近成功心跳 / 响应" Style="{StaticResource ParameterLabel}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Heartbeat}"/><TextBlock Text="{Binding Response}" Margin="12,0,0,0"/></StackPanel>
        <TextBlock Text="{Binding Position}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Error}" Foreground="#D99735" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
      <Border Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" Padding="12">
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding OnlineVehicles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></Border.Style>
       <TextBlock Text="当前没有在线 AGV&#10;请在通信设置 / 通信诊断中检查连接。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
      </Border>
      </Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="绿：在线　黄：阻挡 / 定位异常　红：报警 / 急停　灰：离线旧位置" Foreground="#98B3C7" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Grid.Column="1" Text="{Binding UpdateText}" Foreground="#98B3C7" FontSize="10" Margin="12,0,0,0"/>
    </Grid>
   </Grid>
  </Border>
  <Border x:Name="CurrentTasksModule" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="当前业务任务" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DataGrid ItemsSource="{Binding ActiveTasks}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="任务编号" Binding="{Binding TaskId}" Width="2*"/><DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="*"/>
       <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="*"/><DataGridTextColumn Header="执行阶段" Binding="{Binding Stage}" Width="*"/>
       <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat={}{0:HH:mm:ss}}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
  </Border>
 </Grid>
</UserControl>
