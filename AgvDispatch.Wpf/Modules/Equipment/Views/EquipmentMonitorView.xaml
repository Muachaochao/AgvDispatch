<UserControl x:Class="AgvDispatch.Wpf.Views.EquipmentMonitorView"
    Foreground="{DynamicResource TextPrimaryBrush}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/AgvDispatch.Wpf;component/Shared/Monitoring/MonitoringStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="设备监控" Style="{StaticResource PageTitleTextStyle}"/>
   <TextBlock Text="查看多 PLC 连接、工位业务状态与原始握手信号。未接入的设备不推测状态，故障与信号未就绪分开定位。" Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,20,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
   <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索编号、名称、地址或状态" Padding="10,6" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource MutedSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
   <CheckBox Grid.Column="2" Content="只看需关注" IsChecked="{Binding AttentionOnly}" VerticalAlignment="Center" Margin="16,0"/>
   <Button Grid.Column="3" Content="立即刷新" Command="{Binding RefreshCommand}" Padding="16,6" Height="36" MinWidth="100" Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
     <DataGrid.Columns>
      <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="100"/>
      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110"/>
      <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="75"/>
      <DataGridTextColumn Header="连接 / 所属PLC" Binding="{Binding Connection}" Width="140"/>
      <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" MinWidth="140" ElementStyle="{StaticResource MonitorTextStyle}"/>
      <DataGridTextColumn Header="数据质量" Binding="{Binding Quality}" Width="100" ElementStyle="{StaticResource MonitorTextStyle}"/>
      <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="165"/>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue=请选择设备}" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="1" Text="{Binding SelectedDevice.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,12"/>
     <TextBlock Grid.Row="2" Text="参数 / 原始信号与诊断" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedDevice.Fields}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
       <DataGridTextColumn Header="参数 / 信号" Binding="{Binding Name}" Width="210"/>
       <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" MinWidth="180" ElementStyle="{StaticResource MonitorTextStyle}"/>
       <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="100"/>
       <DataGridTextColumn Header="地址 / 方向" Binding="{Binding Address}" Width="140"/>
       <DataGridTextColumn Header="采集时间" Binding="{Binding UpdatedAt}" Width="165"/>
       <DataGridTextColumn Header="采集异常原因" Binding="{Binding ErrorMessage}" Width="220" ElementStyle="{StaticResource MonitorTextStyle}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </Grid>
</UserControl>
