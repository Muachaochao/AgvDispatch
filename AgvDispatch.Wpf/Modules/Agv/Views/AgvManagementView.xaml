<UserControl x:Class="AgvDispatch.Wpf.Views.AgvManagementView"
    Foreground="{DynamicResource TextPrimaryBrush}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:hc="https://handyorg.github.io/handycontrol"
 xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <ResourceDictionary Source="/AgvDispatch.Wpf;component/Shared/Monitoring/MonitoringStyles.xaml"/>
  </ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="AGV管理" Style="{StaticResource PageTitleTextStyle}"/>
   <TextBlock Text="查看车辆位置、电量、任务、报警与数据质量。车辆连接参数在系统设置中维护；本页不下发动作。" Style="{StaticResource PageDescriptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,20,0,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,10" TextWrapping="Wrap" Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
   <TextBox Grid.Row="1" MaxWidth="360" HorizontalAlignment="Left" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索编号、名称、地址或状态" AutomationProperties.Name="搜索设备" ToolTip="搜索编号、名称、地址或状态" Padding="10,6" Height="36" VerticalContentAlignment="Center" Background="{DynamicResource MutedSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
   <CheckBox Grid.Row="1" Grid.Column="1" Content="只看需关注" IsChecked="{Binding AttentionOnly}" VerticalAlignment="Center" Margin="16,0"/>
   <Button Grid.Row="1" Grid.Column="2" Content="立即刷新" Command="{Binding RefreshCommand}" Padding="16,6" Height="36" MinWidth="100" Style="{StaticResource AppPrimaryButtonStyle}"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="320"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
    <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
     <DataGrid.Columns>
      <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="75" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="连接 / 所属PLC" Binding="{Binding Connection}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" MinWidth="140" ElementStyle="{StaticResource MonitorTextStyle}"/>
      <DataGridTextColumn Header="数据质量" Binding="{Binding Quality}" Width="100" ElementStyle="{StaticResource MonitorTextStyle}"/>
      <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="165" ElementStyle="{StaticResource AppGridTextStyle}"/>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding SelectedDevice.Name, TargetNullValue=请选择设备}" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Grid.Row="1" Text="{Binding SelectedDevice.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,12"/>
     <TextBlock Grid.Row="2" Text="参数 / 原始信号与诊断" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedDevice.Fields}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
       <DataGridTextColumn Header="参数 / 信号" Binding="{Binding Name}" Width="210" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" MinWidth="180" ElementStyle="{StaticResource MonitorTextStyle}"/>
       <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="地址 / 方向" Binding="{Binding Address}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="采集时间" Binding="{Binding UpdatedAt}" Width="165" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="采集异常原因" Binding="{Binding ErrorMessage}" Width="220" ElementStyle="{StaticResource MonitorTextStyle}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
  </Grid>
  <Expander x:Name="RobokitInspectionPanel" Grid.Row="3" Header="Robokit车端地图、站点与版本（只读核验）" Margin="0,12,0,0">
   <Grid Margin="0,8,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="240"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
     <Button Content="核验所选车辆" Command="{Binding InspectRobokitCommand}" Padding="12,6"/>
     <TextBlock Text="可选路径：逻辑起点" Margin="16,0,6,0" VerticalAlignment="Center"/>
     <TextBox Text="{Binding SourceNodeId, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
     <TextBlock Text="逻辑终点" Margin="12,0,6,0" VerticalAlignment="Center"/>
     <TextBox Text="{Binding TargetNodeId, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" MaxHeight="125" VerticalScrollBarVisibility="Auto" Margin="0,8"><TextBlock Text="{Binding InspectionSummary}" TextWrapping="Wrap"/></ScrollViewer>
    <TabControl Grid.Row="2">
     <TabItem Header="厂家真实站点"><DataGrid ItemsSource="{Binding RobotStations}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
      <DataGridTextColumn Header="厂家编号" Binding="{Binding Id}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="X(m)" Binding="{Binding X}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="Y(m)" Binding="{Binding Y}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="角度(rad)" Binding="{Binding Angle}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="备注" Binding="{Binding Description}" Width="*" MinWidth="300" ElementStyle="{StaticResource MonitorTextStyle}"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="业务节点映射"><DataGrid ItemsSource="{Binding RobotMappings}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
      <DataGridTextColumn Header="逻辑编号" Binding="{Binding NodeId}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="AgvSiteId" Binding="{Binding SiteId}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridCheckBoxColumn Header="唯一存在" Binding="{Binding Found}" Width="90"/><DataGridTextColumn Header="核验说明" Binding="{Binding Reason}" Width="*" MinWidth="450" ElementStyle="{StaticResource MonitorTextStyle}"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="手动核验记录" x:Name="InspectionHistoryTab"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="刷新所选车辆记录" Command="{Binding RefreshInspectionHistoryCommand}" Padding="12,5"/>
       <TextBlock Text="{Binding HistoryMessage}" TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center"/></DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding InspectionHistory}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
       <DataGridTextColumn Header="核验时间" Binding="{Binding At,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="操作人" Binding="{Binding Operator}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridCheckBoxColumn Header="采集成功" Binding="{Binding Available}" Width="90"/>
       <DataGridCheckBoxColumn Header="地图稳定" Binding="{Binding Stable}" Width="90"/>
       <DataGridTextColumn Header="本地版本" Binding="{Binding LocalMapVersion}" Width="180" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="车端地图" Binding="{Binding RobotMap}" Width="160" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="MD5" Binding="{Binding RobotMapMd5}" Width="240" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="失败 / 核验说明" Binding="{Binding Reason}" Width="300" ElementStyle="{StaticResource AppGridTextStyle}"/>
       <DataGridTextColumn Header="核验提示" Binding="{Binding Notes}" Width="400" ElementStyle="{StaticResource AppGridTextStyle}"/>
      </DataGrid.Columns></DataGrid>
     </Grid></TabItem>
    </TabControl>
   </Grid>
  </Expander>
  <Expander x:Name="MapTransferPanel" Grid.Row="4" Header="地图传输记录与处置条件（现场写入关闭）" Margin="0,10,0,0">
   <Grid Height="360" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel>
     <Button Content="刷新所选车辆" Command="{Binding RefreshMapTransfersCommand}" Padding="10,5"/>
     <TextBlock Text="状态" Margin="12,0,5,0" VerticalAlignment="Center"/><TextBox Width="130" Text="{Binding TransferState,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空全部；ReadOnlyPrepared / Blocked / ReviewRequired / Sending / Uncertain / ClosedAfterReview"/>
     <TextBlock Text="创建起止" Margin="12,0,5,0" VerticalAlignment="Center"/><TextBox Width="150" Text="{Binding TransferFrom,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空不限；yyyy-MM-dd HH:mm:ss"/><TextBox Width="150" Margin="6,0" Text="{Binding TransferTo,UpdateSourceTrigger=PropertyChanged}" ToolTip="留空不限；yyyy-MM-dd HH:mm:ss"/>
     <Button Content="上一页" Command="{Binding PreviousMapTransfersCommand}"/><Button Content="下一页" Command="{Binding NextMapTransfersCommand}" Margin="6,0"/>
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="{Binding TransferMessage}" TextWrapping="Wrap" Margin="0,6"/>
    <TabControl Grid.Row="2">
     <TabItem Header="操作列表"><DataGrid ItemsSource="{Binding MapTransfers}" SelectedItem="{Binding SelectedTransfer}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns>
      <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt,StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="200" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="尝试次数" Binding="{Binding AttemptCount}" Width="80" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="目标地图" Binding="{Binding TargetMapName}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="后台版本" Binding="{Binding VersionId}" Width="150" ElementStyle="{StaticResource AppGridTextStyle}"/>
      <DataGridTextColumn Header="操作编号" Binding="{Binding OperationId}" Width="260" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="请求编号" Binding="{Binding RequestId}" Width="220" ElementStyle="{StaticResource AppGridTextStyle}"/>
     </DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="只读历史与处置条件"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="只读进度复核" Command="{Binding ObserveMapTransferCommand}" Padding="10,5" ToolTip="手动只读查询原车辆并留存摘要；失败和未启用也留存，不补发或放行"/><Button Content="历史上一页" Command="{Binding PreviousMapTransferHistoryCommand}" Margin="8,0"/><Button Content="历史下一页" Command="{Binding NextMapTransferHistoryCommand}"/></WrapPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,12,0"><TextBlock Text="{Binding TransferDetail}" TextWrapping="Wrap"/></ScrollViewer>
       <DataGrid Grid.Column="1" ItemsSource="{Binding MapTransferEvents}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding OccurredAt,StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="200" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="145" ElementStyle="{StaticResource AppGridTextStyle}"/>
        <DataGridTextColumn Header="操作人" Binding="{Binding Operator}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="留存证据" Binding="{Binding Evidence}" Width="500" ElementStyle="{StaticResource MonitorTextStyle}"/>
       </DataGrid.Columns></DataGrid>
      </Grid>
     </Grid></TabItem>
    </TabControl>
   </Grid>
  </Expander>
  <TextBlock Grid.Row="5" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </Grid>
</UserControl>
