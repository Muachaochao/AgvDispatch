<UserControl x:Class="AgvDispatch.Wpf.Views.CommunicationDiagnosticView"
    Foreground="{DynamicResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="通信诊断" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="从Windows Service读取PLC、AGV、任务、数据库及Named Pipe只读快照。"
                               Style="{StaticResource PageDescriptionTextStyle}" Margin="0,6,0,0" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <TextBlock Text="{Binding GeneratedAt, StringFormat=快照时间：{0}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button Content="立即刷新" Command="{Binding RefreshCommand}" Padding="16,8" />
                </WrapPanel>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="5">
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel><TextBlock Text="后台服务" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ServiceState}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel><TextBlock Text="数据库" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DatabaseState}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel><TextBlock Text="PLC" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PlcState}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel><TextBlock Text="AGV" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding AgvState}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}" Margin="0">
                    <StackPanel><TextBlock Text="活动任务" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TaskState}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="PLC连接与点位质量" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlcConnectionDetails}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding PlcSignalDetails}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="AGV连接、心跳、电量与报警" FontSize="16" FontWeight="SemiBold" Margin="4,2,0,10" />
                    <DataGrid ItemsSource="{Binding Agvs}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="85"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="95"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Endpoint}" Width="140"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="连接" Binding="{Binding Connection}" Width="95"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="80"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="电量" Binding="{Binding BatteryPercent, StringFormat={}{0:F1}%}" Width="75"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="站点" Binding="{Binding CurrentStation}" Width="95"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="导航状态" Binding="{Binding NavigationState}" Width="110"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="任务" Binding="{Binding TaskCount}" Width="55"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="报警" Binding="{Binding AlarmCount}" Width="55"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="最近心跳" Binding="{Binding LastSuccessfulPollAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="响应ms" Binding="{Binding LastResponseTimeMs, StringFormat=F1}" Width="75"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="连续失败" Binding="{Binding ConsecutiveFailures}" Width="75"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="活动任务状态" FontSize="16" FontWeight="SemiBold" Margin="4,2,0,10" />
                        <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Height="190">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务" Binding="{Binding TaskId}" Width="145"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="90"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="AGV" Binding="{Binding VehicleId}" Width="80"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Stage}" Width="130"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="厂家任务" Binding="{Binding VendorTaskId}" Width="145"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="145"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Named Pipe会话" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PipeDetails}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock Text="现场写入安全开关" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SafetyDetails}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="10" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
