<UserControl x:Class="AgvDispatch.Wpf.Views.ConnectionSettingsView"
    Foreground="{DynamicResource TextPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="38" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="Margin" Value="0,9,0,4" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}"><Setter Property="Padding" Value="10,6" /></Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="重新加载" Command="{Binding ReloadCommand}" Height="38" Padding="16,6" Margin="0,0,10,0" ToolTip="重新加载会丢弃当前未保存修改" />
                <Button Content="保存连接配置" Style="{StaticResource AppPrimaryButtonStyle}" Click="SaveClick" IsEnabled="{Binding CanSave}" Height="38" Padding="16,6" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock Text="系统设置 · 通信连接" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="管理多台PLC与AGV的连接参数；保存后重启后台服务生效。" Style="{StaticResource PageDescriptionTextStyle}" Margin="0,6,0,0" /></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,12">
            <StackPanel><TextBlock Text="{Binding ApplyStatus}" FontWeight="SemiBold" />
                <TextBlock Text="保存仅写入连接配置，重启后台后生效；启动恢复尚未放行时也可保存。实际地图切换中或存在未结束业务任务时不能保存。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                <TextBlock Text="采集启用不等于允许写入或派车。TCP测试不发送协议报文；实际协议和点位质量请看通信诊断。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
        </Border>
        <TabControl Grid.Row="2">
            <TabItem Header="PLC连接">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="添加PLC" Command="{Binding AddPlcCommand}" Padding="12,7" />
                            <Button Content="移除所选" Command="{Binding RemovePlcCommand}" Padding="12,7" Margin="8,0" />
                            <Button Content="测试TCP连接" Command="{Binding ProbePlcCommand}" Padding="12,7" />
                        </StackPanel>
                        <DataGrid x:Name="PlcGrid" Grid.Row="1" ItemsSource="{Binding Plcs}" SelectedItem="{Binding SelectedPlc}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="启动采集" Binding="{Binding Enabled}" Width="85" />
                                <DataGridTextColumn Header="PLC编号" Binding="{Binding DeviceId}" Width="120"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="120"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="系列" Binding="{Binding SiemensSeries}" Width="95"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="140"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="75"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="CSV点表" Binding="{Binding SignalCsvPath}" Width="*" MinWidth="180"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding CanManage}">
                                <TextBlock Text="所选PLC参数" FontSize="16" FontWeight="SemiBold" />
                                <CheckBox Content="后台启动时启用采集" IsChecked="{Binding SelectedPlc.Enabled}" Margin="0,12,0,0" />
                                <TextBlock Text="设备编号（全局唯一）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.DeviceId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="显示名称" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="西门子系列" Style="{StaticResource SettingLabel}" /><ComboBox ItemsSource="{Binding SiemensSeries}" SelectedItem="{Binding SelectedPlc.SiemensSeries}" />
                                <TextBlock Text="IPv4地址" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="端口" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                <TextBlock Text="Rack / Slot（留空使用驱动默认值）" Style="{StaticResource SettingLabel}" />
                                <UniformGrid Columns="2"><TextBox Text="{Binding SelectedPlc.Rack, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding SelectedPlc.Slot, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                                <TextBlock Text="CSV点表路径（后台config目录）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.SignalCsvPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 config/plc-signals.csv；多PLC需分别准备点表，工位编号不可重复。" />
                                <TextBlock Text="启用采集前，需填写后台 config 目录内的“后台用点表 CSV”，例如 config/plc-signals.csv。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock Text="模拟 PLC：从联调台“连接与点表”页导出。工具配置 JSON 和“完整会话 CSV”不能作为点表。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="轮询周期 ms" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.PollIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                <TextBlock Text="连接 / 接收超时 ms" Style="{StaticResource SettingLabel}" />
                                <UniformGrid Columns="2"><TextBox Text="{Binding SelectedPlc.ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding SelectedPlc.ReceiveTimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                                <TextBlock Text="重连间隔 / 信号过期 ms" Style="{StaticResource SettingLabel}" />
                                <UniformGrid Columns="2"><TextBox Text="{Binding SelectedPlc.ReconnectDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding SelectedPlc.StaleAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                                <TextBlock Text="连续失败阈值 / 批量读取字节" Style="{StaticResource SettingLabel}" />
                                <UniformGrid Columns="2"><TextBox Text="{Binding SelectedPlc.InterruptedFailureThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding SelectedPlc.ReadBlockSizeBytes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                                <TextBlock Text="Local TSAP / Dest TSAP（十进制，可留空）" Style="{StaticResource SettingLabel}" />
                                <UniformGrid Columns="2"><TextBox Text="{Binding SelectedPlc.LocalTsap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding SelectedPlc.DestTsap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                                <TextBlock Text="ConnectionType（可留空）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedPlc.ConnectionType, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="AGV连接">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="添加AGV" Command="{Binding AddAgvCommand}" Padding="12,7" />
                            <Button Content="移除所选" Command="{Binding RemoveAgvCommand}" Padding="12,7" Margin="8,0" />
                            <Button Content="测试TCP连接" Command="{Binding ProbeAgvCommand}" Padding="12,7" />
                        </StackPanel>
                        <DataGrid x:Name="AgvGrid" Grid.Row="1" ItemsSource="{Binding Agvs}" SelectedItem="{Binding SelectedAgv}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70" />
                                <DataGridTextColumn Header="车辆编号" Binding="{Binding VehicleId}" Width="120"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="140"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="150"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="状态端口" Binding="{Binding Port}" Width="90"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                                <DataGridTextColumn Header="导航端口" Binding="{Binding NavigationPort}" Width="90"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanManage}">
                            <TextBlock Text="所选AGV参数" FontSize="16" FontWeight="SemiBold" />
                            <CheckBox Content="启用这台车" IsChecked="{Binding SelectedAgv.Enabled}" Margin="0,12,0,0" />
                            <TextBlock Text="车辆编号（唯一）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedAgv.VehicleId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="显示名称" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedAgv.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="IPv4地址" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedAgv.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="状态端口（默认19204）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedAgv.Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            <TextBlock Text="导航端口（默认19206）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding SelectedAgv.NavigationPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            <Separator Margin="0,18,0,12" /><TextBlock Text="AGV公共采集参数" FontWeight="SemiBold" />
                            <CheckBox Content="后台启动时启用AGV采集" IsChecked="{Binding Configuration.AgvEnabled}" Margin="0,12,0,0" />
                            <TextBlock Text="Robokit协议版本（1或2，全车共用）" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding Configuration.AgvProtocolVersion, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            <TextBlock Text="轮询周期 ms" Style="{StaticResource SettingLabel}" /><TextBox Text="{Binding Configuration.AgvPollIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            <TextBlock Text="连接 / 请求超时 ms" Style="{StaticResource SettingLabel}" />
                            <UniformGrid Columns="2"><TextBox Text="{Binding Configuration.AgvConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding Configuration.AgvRequestTimeoutMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                            <TextBlock Text="重连间隔 / 数据过期 ms" Style="{StaticResource SettingLabel}" />
                            <UniformGrid Columns="2"><TextBox Text="{Binding Configuration.AgvReconnectDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Margin="0,0,5,0" /><TextBox Text="{Binding Configuration.AgvStaleAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></UniformGrid>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Robokit地图绑定" x:Name="MapBindingTab">
                <TabControl Margin="6"><TabItem Header="绑定配置">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding RuntimeMapText}" FontWeight="SemiBold"/>
                        <TextBlock Text="新增绑定带入所选车辆及当前运行地图；车端名称、MD5来自AGV管理的只读核验。坐标确认需人工填写依据。保存后重启后台生效。" TextWrapping="Wrap" Margin="0,6,0,8"/>
                        <StackPanel Orientation="Horizontal"><Button Content="新增绑定" Command="{Binding AddMapBindingCommand}" Padding="12,6"/>
                            <Button Content="移除所选绑定" Command="{Binding RemoveMapBindingCommand}" Padding="12,6" Margin="8,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*" MinWidth="360"/></Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding MapBindings}" SelectedItem="{Binding SelectedMapBinding}" IsReadOnly="True"><DataGrid.Columns>
                            <DataGridTextColumn Header="车辆" Binding="{Binding VehicleId}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="本地图版本" Binding="{Binding LocalMapVersion}" Width="200" ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridTextColumn Header="车端地图" Binding="{Binding RobotMap}" Width="180" ElementStyle="{StaticResource AppGridTextStyle}"/>
                            <DataGridCheckBoxColumn Header="坐标已核定" Binding="{Binding CoordinatesVerified}" Width="100"/>
                        </DataGrid.Columns></DataGrid>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="14" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanManage}">
                                <TextBlock Text="所选地图绑定" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="车辆编号" Style="{StaticResource SettingLabel}"/><ComboBox ItemsSource="{Binding Agvs}" DisplayMemberPath="VehicleId" SelectedValuePath="VehicleId" SelectedValue="{Binding SelectedMapBinding.VehicleId}"/>
                                <TextBlock Text="本地运行地图ID" Style="{StaticResource SettingLabel}"/><TextBox Text="{Binding SelectedMapBinding.LocalMapId,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="本地发布版本ID" Style="{StaticResource SettingLabel}"/><TextBox Text="{Binding SelectedMapBinding.LocalMapVersion,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="车端地图名称（1300）" Style="{StaticResource SettingLabel}"/><TextBox Text="{Binding SelectedMapBinding.RobotMap,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="车端MD5（32位十六进制）" Style="{StaticResource SettingLabel}"/><TextBox Text="{Binding SelectedMapBinding.RobotMapMd5,UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="已核定坐标对应（人工声明）" IsChecked="{Binding SelectedMapBinding.CoordinatesVerified}" Margin="0,14,0,4"/>
                                <TextBlock Text="坐标核对依据 / 日期" Style="{StaticResource SettingLabel}"/><TextBox Text="{Binding SelectedMapBinding.ConfirmationNote,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="75"/>
                            </StackPanel></ScrollViewer>
                        </Border>
                    </Grid>
                </Grid></TabItem>
                <TabItem Header="离线核对报告（只读）" x:Name="MapReviewTab">
                  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Content="导入核对报告" Command="{Binding ImportMapReviewCommand}" Padding="12,6" AutomationProperties.Name="导入离线核对报告"/>
                      <Button Content="取消 / 清空" Command="{Binding ClearMapReviewCommand}" Padding="12,6" Margin="8,0"/>
                      <CheckBox Content="只看差异和待核定站点" IsChecked="{Binding ShowOnlyMapDifferences}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Border Grid.Row="1" Background="{DynamicResource MutedSurfaceBrush}" Padding="10" CornerRadius="5"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ReviewLocatorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                      <TextBlock Text="只读历史报告 · 不修改绑定或人工确认，不连接设备，不批准控制或上传" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding MapReviewMessage}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      <TextBlock Text="请选择工具生成的review.json，保留同目录inputs四份原始输入。哈希一致只证明文件对应，报告结果为导入声明，未在界面重算。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                    <ScrollViewer Grid.Row="2" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,8"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding ReviewLocatorOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><StackPanel>
                      <TextBlock Text="{Binding MapReviewContext}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding MapReview.CapturedAt,StringFormat=报告采集时间：{0}}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding MapReview.Sha256,StringFormat=报告SHA256：{0}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel></ScrollViewer>
                    <TabControl Grid.Row="3">
                      <TabItem Header="逐站差异"><DataGrid ItemsSource="{Binding MapReviewStations}" SelectedItem="{Binding SelectedReviewStation}" SelectionMode="Single" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="厂家站点" Binding="{Binding SiteId}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="业务节点" Binding="{Binding LogicalId}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="原图X/m" Binding="{Binding SourceX,StringFormat=0.####}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="原图Y/m" Binding="{Binding SourceY,StringFormat=0.####}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="车端X/m" Binding="{Binding DeviceX,StringFormat=0.####}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="车端Y/m" Binding="{Binding DeviceY,StringFormat=0.####}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="原图-车端差/m" Binding="{Binding XyDeltaM,StringFormat=0.####}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="本地变换差/m" Binding="{Binding LocalDeltaM,StringFormat=0.####}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="朝向差/rad" Binding="{Binding AngleDeltaRadians,StringFormat=0.####}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="声明结果" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="差异/待核定" Binding="{Binding Issues}" Width="300" ElementStyle="{StaticResource AppGridTextStyle}"/>
                      </DataGrid.Columns></DataGrid></TabItem>
                      <TabItem Header="地图定位与搜索" IsSelected="{Binding ReviewLocatorOpen}" x:Name="MapReviewLocatorTab">
                        <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                          <WrapPanel Margin="0,0,0,6">
                            <TextBox Text="{Binding ReviewSearchQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Width="190" ToolTip="输入业务、厂家或路段编号，回车搜索"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchReviewMapCommand}"/></TextBox.InputBindings></TextBox>
                            <ComboBox ItemsSource="{Binding ReviewSearchModes}" SelectedItem="{Binding ReviewSearchMode}" Width="110" Margin="6,0"/>
                            <Button Content="搜索编号" Command="{Binding SearchReviewMapCommand}" Padding="10,5"/>
                            <Button Content="全图" Command="{Binding FitReviewMapCommand}" Padding="10,5" Margin="6,0"/>
                            <Button Content="＋" Command="{Binding ZoomInReviewMapCommand}" ToolTip="放大只读快照" Padding="10,5"/>
                            <Button Content="－" Command="{Binding ZoomOutReviewMapCommand}" ToolTip="缩小只读快照" Padding="10,5" Margin="6,0"/>
                            <ComboBox ItemsSource="{Binding ReviewRouteRoles}" SelectedItem="{Binding ReviewRouteRole}" Width="140" Margin="6,0"/>
                            <Button Content="高亮运输路线" Command="{Binding HighlightReviewRoutesCommand}" Padding="10,5"/>
                          </WrapPanel>
                          <TextBlock Grid.Row="1" Text="{Binding ReviewLocationMessage}" ToolTip="{Binding ReviewLocationMessage}" TextWrapping="Wrap" MaxHeight="70" Margin="0,0,0,6"/>
                          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                              <TabControl>
                                <TabItem Header="搜索候选"><DataGrid ItemsSource="{Binding ReviewSearchResults}" SelectedItem="{Binding SelectedReviewHit}" SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
                                  <DataGridTextColumn Header="业务 / 路段编号" Binding="{Binding Id}" Width="120" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="厂家编号 / 端点" Binding="{Binding VendorId}" Width="130" ElementStyle="{StaticResource AppGridTextStyle}"/>
                                </DataGrid.Columns></DataGrid></TabItem>
                                <TabItem Header="路线子段" IsSelected="{Binding ReviewSegmentsOpen}"><DataGrid x:Name="ReviewSegmentGrid" Loaded="ReviewSegmentLoaded" SelectionChanged="ReviewSegmentSelectionChanged" ItemsSource="{Binding ReviewRouteSegments}" SelectedItem="{Binding SelectedReviewSegment}" SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableRowVirtualization="True"><DataGrid.Columns>
                                  <DataGridTextColumn Header="运输阶段" Binding="{Binding Role}" Width="120" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="段" Binding="{Binding Step}" Width="45" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="路段" Binding="{Binding RoadId}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="声明结果" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource AppGridTextStyle}"/>
                                </DataGrid.Columns></DataGrid></TabItem>
                              </TabControl>
                              <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="4,6,4,0"><TextBlock Text="{Binding ReviewSegmentDetails}" TextWrapping="Wrap"/></ScrollViewer>
                            </Grid>
                            <Border Grid.Column="2" Background="{DynamicResource MutedSurfaceBrush}" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" ClipToBounds="True">
                              <Viewbox Stretch="Uniform"><Canvas Width="900" Height="520" ClipToBounds="True">
                                <Canvas Width="900" Height="520"><Canvas.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding ReviewZoom}" ScaleY="{Binding ReviewZoom}" CenterX="450" CenterY="260"/><TranslateTransform X="{Binding ReviewPanX}" Y="{Binding ReviewPanY}"/></TransformGroup></Canvas.RenderTransform>
                                  <ItemsControl ItemsSource="{Binding ReviewMapRoads}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Path Data="{Binding Geometry}" Stroke="#7D91AA" StrokeThickness="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                  <Path Data="{Binding ReviewSelectedRoadGeometry}" Stroke="#FFD34D" StrokeThickness="11" IsHitTestVisible="False"/>
                                  <ItemsControl ItemsSource="{Binding ReviewRouteHighlights}" Width="900" Height="520"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Canvas Width="900" Height="520">
                                    <Path Data="{Binding Geometry}" Stroke="Transparent" StrokeThickness="14" ToolTip="{Binding Tooltip}" MouseLeftButtonDown="ReviewRouteClick" Cursor="Hand"/>
                                    <Path Data="{Binding Geometry}" Stroke="{Binding Color}" StrokeThickness="5" IsHitTestVisible="False"/>
                                    <Path Data="{Binding Arrows}" Fill="{Binding Color}" Stroke="{DynamicResource MutedSurfaceBrush}" StrokeThickness="0.8" IsHitTestVisible="False"/>
                                  </Canvas></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                  <ItemsControl ItemsSource="{Binding ReviewMapDots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Ellipse Width="10" Height="10" Fill="#279BF1" Stroke="White" StrokeThickness="1" ToolTip="{Binding Tooltip}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                  <Ellipse Width="24" Height="24" Canvas.Left="{Binding ReviewMarkerX}" Canvas.Top="{Binding ReviewMarkerY}" Stroke="#F28C28" StrokeThickness="3" IsHitTestVisible="False"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ReviewHasMarker}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                </Canvas>
                              </Canvas></Viewbox>
                            </Border>
                          </Grid>
                        </Grid>
                      </TabItem>
                      <TabItem Header="四段运输"><DataGrid SelectedItem="{Binding SelectedReviewRoute}" SelectionMode="Single" ItemsSource="{Binding MapReview.Routes}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
                        <DataGridTextColumn Header="运输角色" Binding="{Binding RoleText}" Width="140" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="段序号" Binding="{Binding Step}" Width="65" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="业务起点" Binding="{Binding LogicalFrom}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="业务终点" Binding="{Binding LogicalTo}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="厂家起点" Binding="{Binding VendorFrom}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="厂家终点" Binding="{Binding VendorTo}" Width="110" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="声明结果" Binding="{Binding Status}" Width="85" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="差异原因" Binding="{Binding Issues}" Width="400" ElementStyle="{StaticResource AppGridTextStyle}"/>
                      </DataGrid.Columns></DataGrid></TabItem>
                      <TabItem Header="厂家行为"><DataGrid ItemsSource="{Binding MapReview.Behaviors}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns>
                        <DataGridTextColumn Header="规则" Binding="{Binding RuleText}" Width="220" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="资料状态（非核定）" Binding="{Binding StatusText}" Width="170" ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="提交说明" Binding="{Binding Statement}" Width="300" ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="声明来源" Binding="{Binding Source}" Width="300" ElementStyle="{StaticResource AppGridTextStyle}"/>
                      </DataGrid.Columns></DataGrid></TabItem>
                      <TabItem Header="错误和待核定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
                        <TextBlock Text="{Binding MapReview.DetailLimitMessage}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock Text="报告错误" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding MapReview.DisplayErrors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="待核定 / 未完成" FontWeight="SemiBold" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding MapReview.DisplayPending}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                  </Grid>
                </TabItem></TabControl>
            </TabItem>
            <TabItem Header="当前PLC连接 / 保存审计">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button Content="刷新运行状态（保留编辑内容）" Command="{Binding RefreshStatusCommand}" HorizontalAlignment="Left" Height="34" Padding="12,6" Margin="0,0,0,10" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Snapshot.PlcConnections}" IsReadOnly="True"><DataGrid.Columns>
                        <DataGridTextColumn Header="PLC" Binding="{Binding DeviceId}" Width="130"  ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="140"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="连接状态" Binding="{Binding State}" Width="140"  ElementStyle="{StaticResource AppGridTextStyle}"/><DataGridTextColumn Header="连续失败" Binding="{Binding ConsecutiveFailures}" Width="90"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="最近成功采集" Binding="{Binding LastSuccessfulReadAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                    </DataGrid.Columns></DataGrid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Snapshot.Audits}" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns>
                        <DataGridTextColumn Header="保存时间" Binding="{Binding At, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="操作账号" Binding="{Binding Operator}" Width="210"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                        <DataGridTextColumn Header="操作摘要" Binding="{Binding Summary}" Width="*"  ElementStyle="{StaticResource AppGridTextStyle}"/>
                    </DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
    </Grid>
</UserControl>
