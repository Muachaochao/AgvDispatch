<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regression-only host for historical UI tests. Never published by the daily bundle. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><AssemblyName>AgvDispatch.Wpf</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../AgvDispatch.Infrastructure/AgvDispatch.Infrastructure.csproj"/>
    <PackageReference Include="HandyControl" Version="3.5.1"/>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5"/>
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.1"/>
    <PackageReference Include="Prism.DryIoc" Version="8.1.97"/>
    <ApplicationDefinition Include="../../AgvDispatch.Wpf/App.xaml" Link="App.xaml"/>
    <Compile Include="../../AgvDispatch.Wpf/**/*.cs" Exclude="../../AgvDispatch.Wpf/bin/**;../../AgvDispatch.Wpf/obj/**;../../AgvDispatch.Wpf/Management/**" Link="%(RecursiveDir)%(Filename)%(Extension)"/>
    <Page Include="../../AgvDispatch.Wpf/**/*.xaml" Exclude="../../AgvDispatch.Wpf/App.xaml;../../AgvDispatch.Wpf/bin/**;../../AgvDispatch.Wpf/obj/**;../../AgvDispatch.Wpf/Management/**" Link="%(RecursiveDir)%(Filename)%(Extension)"/>
    <Resource Include="../../AgvDispatch.Wpf/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
