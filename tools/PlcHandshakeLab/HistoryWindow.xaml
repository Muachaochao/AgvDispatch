<Window x:Class="PlcHandshakeLab.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="历史会话 · 只读回看" Width="1180" Height="820" MinWidth="900" MinHeight="620" Background="#F3F6FA" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="历史会话 · 只读回看" FontSize="25" FontWeight="Bold"/><TextBlock Text="不启动S7 · 不恢复P/H · 不操作调度任务" Foreground="#147F79" Margin="0,8"/><TextBlock x:Name="SourceInfo" TextWrapping="Wrap"/><Border Background="#FFF2CF" Padding="10" Margin="0,10"><TextBlock x:Name="Warnings" TextWrapping="Wrap"/></Border></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="工位 / 轮次" VerticalAlignment="Center"/><ComboBox x:Name="GroupChoice" DisplayMemberPath="Label" Width="300" Margin="10,0" SelectionChanged="Group_Changed"/><TextBlock x:Name="Summary" VerticalAlignment="Center"/></WrapPanel>
  <TabControl Grid.Row="2" Background="White"><TabItem Header="28阶段结果"><DataGrid x:Name="Results" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" RowHeight="32" BorderThickness="0"><DataGrid.Columns>
   <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="60"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="205"/><DataGridTextColumn Header="最后结果" Binding="{Binding Outcome}" Width="85"/><DataGridTextColumn Header="记录时间" Binding="{Binding Time}" Width="95"/><DataGridTextColumn Header="车辆" Binding="{Binding Vehicle}" Width="100"/><DataGridTextColumn Header="任务" Binding="{Binding TaskId}" Width="130"/><DataGridTextColumn Header="观察 / 原因" Binding="{Binding Note}" Width="*"/>
  </DataGrid.Columns></DataGrid></TabItem><TabItem Header="最近500条原始事件"><ListBox x:Name="Events" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></TabItem></TabControl>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button Content="导出完整历史CSV" Click="Csv_Click"/><Button Content="导出阶段报告" Click="Report_Click"/><Button Content="导出历史证据ZIP" Click="Bundle_Click"/><Button x:Name="CancelButton" Content="取消导出" Click="Cancel_Click" IsEnabled="False"/></WrapPanel><TextBlock x:Name="Progress" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
 </Grid>
</Window>
