<Window x:Class="PlcHandshakeLab.NetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PLC 人工联调台 · S7 TCP 模拟服务" Width="1380" Height="900" MinWidth="1120" MinHeight="740" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F6FA">
 <Window.Resources>
  <Style x:Key="PointGrid" TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="46"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E1E8EF"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Source}"/></Style></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="SignalName"><StackPanel VerticalAlignment="Center" Margin="5,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" FontSize="11" Foreground="#64748B"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="SignalValue"><StackPanel VerticalAlignment="Center"><WrapPanel><Border Background="{Binding Color}" Padding="5,1" Margin="2,0,5,0"><TextBlock Text="{Binding Value}" Foreground="White" FontWeight="Bold"/></Border><TextBlock Text="{Binding Expected}" VerticalAlignment="Center" FontSize="11"/></WrapPanel><TextBlock Text="{Binding Quality}" Foreground="#64748B" FontSize="11" Margin="2,3,0,0"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="ManualButtons"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="置1" Tag="{Binding Signal}" IsEnabled="{Binding CanSet}" Click="SetHigh_Click" Padding="7,5" Margin="2,0"/><Button Content="清0" Tag="{Binding Signal}" IsEnabled="{Binding CanClear}" Click="SetLow_Click" Padding="7,5" Margin="2,0"/></StackPanel></DataTemplate>
  <Style x:Key="OutcomeText" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding Outcome}" Value="通过"><Setter Property="Foreground" Value="#147F79"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="失败"><Setter Property="Foreground" Value="#B42318"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="跳过"><Setter Property="Foreground" Value="#886031"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><TextBlock Text="PLC 人工联调台" FontSize="23" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="独立模拟PLC · H由调度写入 · 不下发AGV指令" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#147F79"/></DockPanel>
  <Border Grid.Row="1" Background="White" Padding="12" CornerRadius="6" Margin="0,0,0,8"><StackPanel>
   <WrapPanel><Button x:Name="StartButton" Content="启动 S7 服务" Click="Start_Click" Background="#147F79" Foreground="White"/><Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" IsEnabled="False"/><TextBlock Text="PLC反馈模式" VerticalAlignment="Center" Margin="12,0,6,0"/><ComboBox x:Name="AutoMode" SelectedIndex="0" Width="255" SelectionChanged="AutoMode_Changed"><ComboBoxItem Content="人工控制全部P点"/><ComboBoxItem Content="自动闭环（仅人工置呼叫）"/></ComboBox><TextBlock x:Name="ConnectionStatus" Text="未启动 · 配置地址后由调度主动连接" VerticalAlignment="Center" Margin="16,0,0,0"/></WrapPanel>
   <Border x:Name="HealthBanner" Background="MistyRose" Padding="8" Margin="0,8,0,0"><TextBlock x:Name="HealthText" FontWeight="Bold" Text="调度未连接" TextWrapping="Wrap"/></Border>
   <TextBlock x:Name="AutoState" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="Message" Text="默认只监听本机127.0.0.1:10200。厂家联调请在“连接与点表”设置本机网卡IP和允许的调度IP。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#886031"/>
  </StackPanel></Border>
  <TabControl x:Name="NetworkTabs" Grid.Row="2" Background="White" BorderBrush="#D5DFEB">
   <TabItem Header="人工联调面板"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><TextBlock Text="观察工位" VerticalAlignment="Center"/><ComboBox x:Name="Station" Width="130" Margin="10,0" SelectionChanged="Station_Changed"/><TextBlock Text="核心10点固定展示 · H输出由调度写入 · 电平不代表物理动作完成" VerticalAlignment="Center" Foreground="#64748B" TextWrapping="Wrap"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="630"/><ColumnDefinition Width="4*" MinWidth="300"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <GroupBox Header="P · PLC输入 / 人工操作" Margin="0,0,6,0" BorderBrush="#A7CFCB"><DataGrid x:Name="PPoints" Style="{StaticResource PointGrid}"><DataGrid.Columns>
       <DataGridTemplateColumn Header="信号 / 地址" CellTemplate="{StaticResource SignalName}" Width="*" MinWidth="108"/>
       <DataGridTemplateColumn Header="当前 / 参考" CellTemplate="{StaticResource SignalValue}" Width="114"/>
       <DataGridTemplateColumn Header="人工输入" CellTemplate="{StaticResource ManualButtons}" Width="96"/>
      </DataGrid.Columns></DataGrid></GroupBox>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">      <Expander  Margin="0,8,6,0" x:Name="FaultExpander"><Expander.Header><TextBlock x:Name="FaultSummary" Text="故障与下游联锁 · 展开设置" FontWeight="SemiBold"/></Expander.Header>
       <DataGrid x:Name="FaultPoints" Height="172" Style="{StaticResource PointGrid}"><DataGrid.Columns>
        <DataGridTemplateColumn Header="故障 / 联锁信号" CellTemplate="{StaticResource SignalName}" Width="*"/>
        <DataGridTemplateColumn Header="当前 / 新鲜度" CellTemplate="{StaticResource SignalValue}" Width="145"/>
        <DataGridTemplateColumn Header="人工输入" CellTemplate="{StaticResource ManualButtons}" Width="100"/>
       </DataGrid.Columns></DataGrid>
      </Expander></ScrollViewer>
      </Grid>
      <GroupBox Grid.Column="1" Header="H · 调度反馈 / 只读" BorderBrush="#B8C9E0"><DataGrid x:Name="Points" Style="{StaticResource PointGrid}"><DataGrid.Columns>
       <DataGridTemplateColumn Header="信号 / 地址" CellTemplate="{StaticResource SignalName}" Width="*" MinWidth="120"/>
       <DataGridTemplateColumn Header="当前 / 参考" CellTemplate="{StaticResource SignalValue}" Width="133"/>
      </DataGrid.Columns></DataGrid></GroupBox>
     </Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,4,0">
      <TextBlock Text="当前人工标记阶段" FontSize="17" FontWeight="Bold"/>
      <ComboBox x:Name="StageChoice" Margin="0,7,0,6" SelectionChanged="Stage_Changed"/>
      <WrapPanel><Button Content="上一阶段" Click="StageBack_Click" Padding="12,6"/><Button Content="下一阶段" Click="StageNext_Click" Padding="12,6"/><TextBlock Text="只标记，不改变电平" VerticalAlignment="Center" FontSize="11" Foreground="#64748B"/></WrapPanel>
      <TextBlock x:Name="StageCondition" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Border Background="#EAF5F3" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock Text="现在该操作什么 · P" FontWeight="Bold" Foreground="#147F79"/><TextBlock x:Name="Guidance" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="#EDF2FA" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="正在等待什么 · H" FontWeight="Bold"/><TextBlock x:Name="WaitInfo" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <Expander Header="现场观察与本阶段结果" Margin="0,10,0,0"><StackPanel>
       <WrapPanel Margin="0,8,0,0"><TextBlock Text="车辆" VerticalAlignment="Center"/><TextBox x:Name="Vehicle" Width="110" Margin="6,0,8,0"/><TextBlock Text="任务" VerticalAlignment="Center"/><TextBox x:Name="TaskId" Width="115" Margin="6,0,0,0"/></WrapPanel>
       <ComboBox x:Name="ObservationKind" SelectedIndex="0" Margin="0,8,0,6"><ComboBoxItem Content="实际已取箱"/><ComboBoxItem Content="实际到等待点"/><ComboBoxItem Content="实际到倒料点"/><ComboBoxItem Content="倒料已完成"/><ComboBoxItem Content="实际已退出区域"/><ComboBoxItem Content="实际已放箱"/><ComboBoxItem Content="异常 / 其他观察"/></ComboBox>
       <TextBox x:Name="ObservationNote" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
       <Button x:Name="ObserveButton" Content="记录现场观察 + 点位快照" Click="Observe_Click" Margin="0,8,0,0"/>
       <WrapPanel Margin="0,8,0,0"><ComboBox x:Name="TestOutcome" SelectedIndex="0" Width="90"><ComboBoxItem Content="通过"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="跳过"/></ComboBox><CheckBox x:Name="PhysicalConfirmed" Content="本阶段实际条件已核实" Margin="8,4,0,0"/></WrapPanel>
       <Button x:Name="StageTestButton" Content="保存本阶段测试结果" Click="StageTest_Click" Margin="0,8,0,0"/>
      </StackPanel></Expander>
      <Expander Header="操作说明与模拟周期恢复" Margin="0,10,0,0"><StackPanel>
   <TextBlock Text="人工选阶段仅记录，不证明到站、取放或出区。通过需10点交换有效、电平符合，并核实实际条件。自动闭环模式下可只人工置工位呼叫；原任务、车辆到站和原车端取放动作通过验证后，模拟器自动产生箱体与倒料反馈。" TextWrapping="Wrap" Margin="0,6"/>
       <TextBlock Text="28阶段使用plc-28-stage-v2；25/26/27阶段依次清取箱通知、放箱通知、返箱责任。旧任务不能自动迁入。恢复前先核对实际设备与调度原任务，在观察备注中填写依据。" TextWrapping="Wrap" Foreground="#886031"/>
       <Button x:Name="ConfirmClosureButton" Content="确认模拟周期闭合" Click="ConfirmClosure_Click" Margin="0,10,0,0"/>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer>
    </Grid>
    <Button Grid.Row="2" Content="查看与筛选会话日志 →" Click="OpenEvents_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5"/>
   </Grid></TabItem>
    <TabItem Header="同批多工位呼叫"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#EAF5F3" BorderBrush="#A7CFCB" BorderThickness="1" Padding="16" CornerRadius="6"><StackPanel><TextBlock Text="同批呼叫编排" FontSize="21" FontWeight="Bold" Foreground="#0F5F5A"/><TextBlock Text="所选工位会在同一个PLC扫描周期内从0同时变为1。四个工位呼叫一次算1轮；设置2轮即为8单，但第2轮必须等第1轮四站全部完整闭环后才触发。" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#334155"/></StackPanel></Border>
     <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#D5DFEB" BorderThickness="1" Padding="16" Margin="0,0,8,0" CornerRadius="6"><StackPanel><TextBlock Text="1. 选择同批工位" FontSize="17" FontWeight="Bold"/><TextBlock Text="点击工位可选中或反选；启动服务后默认全选当前点表中的工位。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,8"/><ListBox x:Name="BatchStationList" Height="118" SelectionMode="Multiple" SelectionChanged="BatchStation_Changed" BorderBrush="#CBD5E1"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D9F0EB"/><Setter Property="BorderBrush" Value="#147F79"/><Setter Property="Foreground" Value="#0F5F5A"/><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle></ListBox></StackPanel></Border>
      <Border Grid.Column="1" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" Padding="16" Margin="8,0,0,0" CornerRadius="6"><StackPanel><TextBlock Text="2. 设置轮次并开始" FontSize="17" FontWeight="Bold"/><TextBlock Text="只执行一轮验证四站同时呼叫；自动多轮用于排队、派车和持续积压测试。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,10"/><WrapPanel><TextBlock Text="轮次" VerticalAlignment="Center"/><TextBox x:Name="BatchRoundsText" Text="2" Width="58" Margin="7,0,14,0"/><Button x:Name="BatchCallOnceButton" Content="同批呼叫 1 轮" Click="BatchCallOnce_Click" Padding="14,7" Background="#147F79" Foreground="White"/><Button x:Name="BatchCallRoundsButton" Content="按闭环自动多轮" Click="BatchCallRounds_Click" Padding="14,7" Margin="8,0,0,0"/><Button x:Name="BatchStopButton" Content="停止后续轮次" Click="BatchStop_Click" Padding="14,7" Margin="8,0,0,0" IsEnabled="False"/></WrapPanel><Border Background="#F8FAFC" Padding="10" Margin="0,12,0,0"><TextBlock Text="停止会保留当前P/H电平和已创建任务，只禁止继续触发下一轮；当前轮仍须按正常握手闭合。" TextWrapping="Wrap" Foreground="#886031"/></Border></StackPanel></Border>
     </Grid>
     <Border Grid.Row="2" Background="White" BorderBrush="#D5DFEB" BorderThickness="1" Padding="14" Margin="0,16,0,0" CornerRadius="6"><StackPanel><TextBlock Text="3. 当前批次状态" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="BatchCallStatusText" Text="启动服务并连接调度后，可把所选工位在同一次扫描中置1。" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#334155"/></StackPanel></Border>
     <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,16,0,0" CornerRadius="6"><StackPanel><TextBlock Text="系统按以下顺序放行" FontWeight="Bold"/><TextBlock Text="① 每一站都要有箱、下游在线、无故障，且上一轮应答、取箱、返箱责任和放箱通知全部清0。&#10;② 正式后台自主创建四单并选车；四站全部闭环且倒料共享位为空，才允许下一轮同时置1。" TextWrapping="Wrap" LineHeight="23" Margin="0,6,0,0" Foreground="#475569"/></StackPanel></Border>
    </Grid></TabItem>
   <TabItem Header="逐阶段测试结果"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="工位" VerticalAlignment="Center"/><ComboBox Width="130" Margin="8,0" ItemsSource="{Binding ItemsSource, ElementName=Station}" SelectedItem="{Binding SelectedItem, ElementName=Station, Mode=TwoWay}"/><Button Content="新一轮记录（不复位点位）" Click="BeginRound_Click"/><Button Content="导出完整阶段报告" Click="ExportStageReport_Click"/><CheckBox x:Name="FailedOnly" Content="仅显示失败" Margin="8,5" Checked="ResultFilter_Changed" Unchecked="ResultFilter_Changed"/></WrapPanel>
    <TextBlock x:Name="TestSummary" Grid.Row="1" Margin="0,12" TextWrapping="Wrap" FontWeight="Bold"/>
    <StackPanel Grid.Row="2" Margin="0,0,0,8"><DockPanel><TextBlock x:Name="ProgressLabel" Width="245"/><ProgressBar x:Name="RoundProgress" Maximum="28" Height="8" VerticalAlignment="Center" Foreground="#147F79"/></DockPanel>
     <ItemsControl x:Name="StageProgress" Margin="0,6,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Stage}" Tag="{Binding Stage}" Click="InspectStage_Click" Margin="1" Padding="0,5" ToolTip="{Binding Tooltip}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E8EEF5"/><Style.Triggers><DataTrigger Binding="{Binding Outcome}" Value="通过"><Setter Property="Background" Value="#CBEAE4"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="失败"><Setter Property="Background" Value="#FADBD8"/></DataTrigger><DataTrigger Binding="{Binding Outcome}" Value="跳过"><Setter Property="Background" Value="#F4E6CC"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="绿=通过 · 红=失败 · 黄=跳过 · 灰=未测；数字点击只查看对照，不改变人工标记阶段。" FontSize="11" Foreground="#64748B"/>
    </StackPanel>
    <Expander Grid.Row="3" Header="记录当前人工标记阶段的结果 · 展开填写（查看其他阶段不会切换标记）" Margin="0,0,0,8"><Border Background="#F3F6FA" Padding="10" Margin="0,0,0,10"><StackPanel>
     <WrapPanel><TextBlock Text="阶段" VerticalAlignment="Center"/><ComboBox Width="260" Margin="8,0" ItemsSource="{Binding ItemsSource, ElementName=StageChoice}" SelectedIndex="{Binding SelectedIndex, ElementName=StageChoice, Mode=TwoWay}"/><TextBlock Text="车辆" VerticalAlignment="Center"/><TextBox Width="130" Margin="8,0" Text="{Binding Text, ElementName=Vehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="任务" VerticalAlignment="Center"/><TextBox Width="210" Margin="8,0" Text="{Binding Text, ElementName=TaskId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
     <TextBlock Text="{Binding Text, ElementName=StageCondition}" TextWrapping="Wrap" Margin="0,6"/>
     <TextBox Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Text, ElementName=ObservationNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="实际观察依据或失败/跳过原因；闭合模拟周期时填写核对依据。"/>
     <WrapPanel Margin="0,8,0,0"><ComboBox Width="90" SelectedIndex="{Binding SelectedIndex, ElementName=TestOutcome, Mode=TwoWay}"><ComboBoxItem Content="通过"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="跳过"/></ComboBox><CheckBox Content="本阶段实际条件已核实" Margin="10,4" IsChecked="{Binding IsChecked, ElementName=PhysicalConfirmed, Mode=TwoWay}"/><Button Content="保存本阶段结果" Click="StageTest_Click" IsEnabled="{Binding IsEnabled, ElementName=StageTestButton}"/><Button Content="确认模拟周期闭合" Click="ConfirmClosure_Click" IsEnabled="{Binding IsEnabled, ElementName=ConfirmClosureButton}"/></WrapPanel>
    </StackPanel></Border></Expander>
    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="StageResults" SelectionChanged="ResultSelection_Changed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="28" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"><DataGrid.Columns>
      <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="50"/><DataGridTextColumn Header="阶段名称" Binding="{Binding Name}" Width="*"/>
      <DataGridTemplateColumn Header="结果" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Outcome}" Style="{StaticResource OutcomeText}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80"/>
     </DataGrid.Columns></DataGrid>
     <Grid Grid.Column="1" Margin="12,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="InspectionTitle" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock x:Name="InspectionNote" Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,6"/>
      <DataGrid x:Name="InspectionPoints" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="23" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E8EF"><DataGrid.Columns>
       <DataGridTextColumn Header="信号" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="参考" Binding="{Binding Expected}" Width="45"/><DataGridTextColumn Header="当前" Binding="{Binding Actual}" Width="45"/><DataGridTextColumn Header="对照 / 质量" Binding="{Binding Status}" Width="110"/>
      </DataGrid.Columns></DataGrid>
      <Expander Grid.Row="3" Header="保存结果时的记录（与当前内存分开）" Margin="0,6,0,0"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SavedInspection" TextWrapping="Wrap" FontSize="11"/></ScrollViewer></Expander>
     </Grid>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="连接与点表"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="Settings">
     <WrapPanel><TextBlock Text="本机监听IP" VerticalAlignment="Center"/><TextBox x:Name="BindIp" Text="127.0.0.1" Width="145" Margin="8,0,16,0"/><TextBlock Text="S7端口" VerticalAlignment="Center"/><TextBox x:Name="PortText" Text="10200" Width="75" Margin="8,0,16,0"/><TextBlock Text="允许调度IP" VerticalAlignment="Center"/><TextBox x:Name="PeerIp" Text="127.0.0.1" Width="145" Margin="8,0,16,0"/><TextBlock Text="自动Done延时(秒)" VerticalAlignment="Center"/><TextBox x:Name="DelayText" Text="5" Width="65" Margin="8,0"/></WrapPanel>
     <WrapPanel Margin="0,12,0,0"><Button Content="导入JSON点表" Click="Import_Click"/><Button Content="添加工位" Click="AddStation_Click"/><TextBox x:Name="NewStation" Width="120" Text="CNC-003" Margin="0,0,8,0"/><Button Content="移除选中工位" Click="RemoveStation_Click"/><TextBlock Text="调度倒料设备编号" VerticalAlignment="Center"/><TextBox x:Name="DumperId" Width="130" Margin="8,0" Text="DUMPER-001"/></WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="信号编号0..9对应28步表；10=工位故障、11=下游在线、12=倒料故障。双击修改DB/字节/位/初值；停服务后才能编辑。共享倒料保留一组。地址唯一且必须与调度点表一致。" TextWrapping="Wrap" Margin="0,12"/>
    <DataGrid x:Name="MappingGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="30">
     <DataGrid.Columns><DataGridTextColumn Header="工位/设备" Binding="{Binding Station}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="信号编号" Binding="{Binding Signal}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="信号" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="归属" Binding="{Binding Owner}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="DB号" Binding="{Binding Db}" Width="90"/><DataGridTextColumn Header="字节" Binding="{Binding Byte}" Width="90"/><DataGridTextColumn Header="位" Binding="{Binding Bit}" Width="70"/><DataGridCheckBoxColumn Header="启动初值" Binding="{Binding Initial}" Width="100"/></DataGrid.Columns>
    </DataGrid>
