<Window x:Class="PlcHandshakeLab.NetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PLC 人工联调台 · S7 TCP 模拟服务" Width="1440" Height="940" MinWidth="1120" MinHeight="760" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F6FA">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><TextBlock Text="PLC 人工联调台" FontSize="26" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="独立模拟PLC · H由调度写入 · 不下发AGV指令" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#147F79"/></DockPanel>
  <Border Grid.Row="1" Background="White" Padding="12" CornerRadius="6" Margin="0,0,0,12"><StackPanel>
   <WrapPanel><Button x:Name="StartButton" Content="启动 S7 服务" Click="Start_Click" Background="#147F79" Foreground="White"/><Button x:Name="StopButton" Content="停止服务" Click="Stop_Click" IsEnabled="False"/><TextBlock Text="PLC反馈模式" VerticalAlignment="Center" Margin="12,0,6,0"/><ComboBox x:Name="AutoMode" SelectedIndex="0" Width="235" SelectionChanged="AutoMode_Changed"><ComboBoxItem Content="人工控制全部P点"/><ComboBoxItem Content="自动握手（箱体仍人工）"/></ComboBox><TextBlock x:Name="ConnectionStatus" Text="未启动 · 配置地址后由调度主动连接" VerticalAlignment="Center" Margin="16,0,0,0"/></WrapPanel>
   <Border x:Name="HealthBanner" Background="MistyRose" Padding="8" Margin="0,8,0,0"><TextBlock x:Name="HealthText" FontWeight="Bold" Text="调度未连接" TextWrapping="Wrap"/></Border>
   <TextBlock x:Name="AutoState" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="Message" Text="默认只监听本机127.0.0.1:10200。厂家联调请在“连接与点表”设置本机网卡IP和允许的调度IP。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#886031"/>
  </StackPanel></Border>
  <TabControl x:Name="NetworkTabs" Grid.Row="2" Background="White" BorderBrush="#D5DFEB">
   <TabItem Header="人工联调面板"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10"><TextBlock Text="观察工位" VerticalAlignment="Center"/><ComboBox x:Name="Station" Width="140" Margin="10,0" SelectionChanged="Station_Changed"/><TextBlock Text="当前点位为服务内存实际值；置1/清0只修改P点。H输出只读。" VerticalAlignment="Center" Foreground="#64748B"/></WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="Points" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="30" GridLinesVisibility="Horizontal" BorderThickness="0" CanUserSortColumns="False" HorizontalGridLinesBrush="#E1E8EF">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Source}"/></Style></DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="归属" Binding="{Binding Owner}" Width="42"/>
       <DataGridTextColumn Header="信号" Binding="{Binding Name}" Width="*" MinWidth="100"/>
       <DataGridTextColumn Header="DB地址" Binding="{Binding Address}" Width="108"/>
       <DataGridTemplateColumn Header="实际值" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding Color}" Padding="4" Margin="3"><TextBlock Text="{Binding Value}" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="请求/最后变化" Binding="{Binding Applied}" Width="112"/>
       <DataGridTextColumn Header="S7交换新鲜度" Binding="{Binding Quality}" Width="110"/>
       <DataGridTemplateColumn Header="手动P输入" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="置1" Tag="{Binding Signal}" IsEnabled="{Binding CanSet}" Click="SetHigh_Click" Padding="6,3" Margin="2,0"/><Button Content="清0" Tag="{Binding Signal}" IsEnabled="{Binding CanClear}" Click="SetLow_Click" Padding="6,3" Margin="2,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0"><StackPanel>
      <TextBlock Text="人工标记阶段 · 不改变电平" FontSize="17" FontWeight="Bold"/>
      <ComboBox x:Name="StageChoice" Margin="0,8,0,6" SelectionChanged="Stage_Changed"/>
      <WrapPanel><Button Content="上一阶段" Click="StageBack_Click"/><Button Content="下一阶段" Click="StageNext_Click"/></WrapPanel>
      <TextBlock x:Name="StageCondition" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock x:Name="WaitInfo" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#147F79"/>
      <TextBlock x:Name="Guidance" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="28阶段已作为plc-28-stage-v2契约；需调度显式启用并配置出区区域和车辆/箱体包络。人工选阶段只记录，不证明到站、取放或出区；第25/26/27阶段依次清取箱通知、放箱通知、最后返箱责任。旧版本任务不能自动迁入。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#886031"/>
      <Separator Margin="0,12"/><TextBlock Text="现场观察（只记录，不触发动作）" FontWeight="Bold"/>
      <WrapPanel Margin="0,8,0,0"><TextBlock Text="车辆" VerticalAlignment="Center"/><TextBox x:Name="Vehicle" Width="125" Margin="6,0,12,0"/><TextBlock Text="任务" VerticalAlignment="Center"/><TextBox x:Name="TaskId" Width="145" Margin="6,0,0,0"/></WrapPanel>
      <ComboBox x:Name="ObservationKind" SelectedIndex="0" Margin="0,8,0,6"><ComboBoxItem Content="实际已取箱"/><ComboBoxItem Content="实际到等待点"/><ComboBoxItem Content="实际到倒料点"/><ComboBoxItem Content="倒料已完成"/><ComboBoxItem Content="实际已退出区域"/><ComboBoxItem Content="实际已放箱"/><ComboBoxItem Content="异常 / 其他观察"/></ComboBox>
      <TextBox x:Name="ObservationNote" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <Button x:Name="ObserveButton" Content="记录现场观察 + 当前点位快照" Click="Observe_Click" Margin="0,8,0,0"/>
      <Separator Margin="0,10"/><TextBlock Text="逐阶段测试记录" FontWeight="Bold"/>
      <WrapPanel Margin="0,6,0,0"><ComboBox x:Name="TestOutcome" SelectedIndex="0" Width="90"><ComboBoxItem Content="通过"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="跳过"/></ComboBox><CheckBox x:Name="PhysicalConfirmed" Content="本阶段实际条件已核实" Margin="10,4,0,0"/></WrapPanel>
      <TextBlock Text="填写上方车辆、任务及实际观察。通过需通信和10点交换有效、电平符合；未记录阶段不算通过。" TextWrapping="Wrap" Margin="0,6"/>
      <Button x:Name="StageTestButton" Content="保存本阶段测试结果" Click="StageTest_Click"/>
      <Button x:Name="ConfirmClosureButton" Content="确认模拟周期闭合（依据填在观察备注）" Click="ConfirmClosure_Click" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <GroupBox Grid.Row="2" Header="最近事件（显示500条，完整会话持续落盘）" Margin="0,10,0,0"><ListBox x:Name="Events" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0"/></GroupBox>
   </Grid></TabItem>
   <TabItem Header="逐阶段测试结果"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="工位" VerticalAlignment="Center"/><ComboBox Width="130" Margin="8,0" ItemsSource="{Binding ItemsSource, ElementName=Station}" SelectedItem="{Binding SelectedItem, ElementName=Station, Mode=TwoWay}"/><Button Content="新一轮记录（不复位点位）" Click="BeginRound_Click"/><Button Content="导出完整阶段报告" Click="ExportStageReport_Click"/></WrapPanel>
    <TextBlock x:Name="TestSummary" Grid.Row="1" Margin="0,12" TextWrapping="Wrap" FontWeight="Bold"/>
    <Border Grid.Row="2" Background="#F3F6FA" Padding="10" Margin="0,0,0,10"><StackPanel>
     <WrapPanel><TextBlock Text="阶段" VerticalAlignment="Center"/><ComboBox Width="260" Margin="8,0" ItemsSource="{Binding ItemsSource, ElementName=StageChoice}" SelectedIndex="{Binding SelectedIndex, ElementName=StageChoice, Mode=TwoWay}"/><TextBlock Text="车辆" VerticalAlignment="Center"/><TextBox Width="130" Margin="8,0" Text="{Binding Text, ElementName=Vehicle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="任务" VerticalAlignment="Center"/><TextBox Width="210" Margin="8,0" Text="{Binding Text, ElementName=TaskId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></WrapPanel>
     <TextBlock Text="{Binding Text, ElementName=StageCondition}" TextWrapping="Wrap" Margin="0,6"/>
     <TextBox Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Text, ElementName=ObservationNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="实际观察依据或失败/跳过原因；闭合模拟周期时填写核对依据。"/>
     <WrapPanel Margin="0,8,0,0"><ComboBox Width="90" SelectedIndex="{Binding SelectedIndex, ElementName=TestOutcome, Mode=TwoWay}"><ComboBoxItem Content="通过"/><ComboBoxItem Content="失败"/><ComboBoxItem Content="跳过"/></ComboBox><CheckBox Content="本阶段实际条件已核实" Margin="10,4" IsChecked="{Binding IsChecked, ElementName=PhysicalConfirmed, Mode=TwoWay}"/><Button Content="保存本阶段结果" Click="StageTest_Click" IsEnabled="{Binding IsEnabled, ElementName=StageTestButton}"/><Button Content="确认模拟周期闭合" Click="ConfirmClosure_Click" IsEnabled="{Binding IsEnabled, ElementName=ConfirmClosureButton}"/></WrapPanel>
    </StackPanel></Border>
    <DataGrid x:Name="StageResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="30" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E8EF" BorderThickness="0"><DataGrid.Columns>
     <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="60"/><DataGridTextColumn Header="阶段名称" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="最后结果" Binding="{Binding Outcome}" Width="100"/><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="实际观察 / 原因" Binding="{Binding Note}" Width="*"/>
    </DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="连接与点表"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="Settings">
     <WrapPanel><TextBlock Text="本机监听IP" VerticalAlignment="Center"/><TextBox x:Name="BindIp" Text="127.0.0.1" Width="145" Margin="8,0,16,0"/><TextBlock Text="S7端口" VerticalAlignment="Center"/><TextBox x:Name="PortText" Text="10200" Width="75" Margin="8,0,16,0"/><TextBlock Text="允许调度IP" VerticalAlignment="Center"/><TextBox x:Name="PeerIp" Text="127.0.0.1" Width="145" Margin="8,0,16,0"/><TextBlock Text="自动Done延时(秒)" VerticalAlignment="Center"/><TextBox x:Name="DelayText" Text="5" Width="65" Margin="8,0"/></WrapPanel>
     <WrapPanel Margin="0,12,0,0"><Button Content="导入JSON点表" Click="Import_Click"/><Button Content="添加工位" Click="AddStation_Click"/><TextBox x:Name="NewStation" Width="120" Text="CNC-003" Margin="0,0,8,0"/><Button Content="移除选中工位" Click="RemoveStation_Click"/><TextBlock Text="调度倒料设备编号" VerticalAlignment="Center"/><TextBox x:Name="DumperId" Width="130" Margin="8,0" Text="DUMPER-001"/></WrapPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="信号编号0..9对应28步表；10=工位故障、11=下游在线、12=倒料故障。双击修改DB/字节/位/初值；停服务后才能编辑。共享倒料保留一组。地址唯一且必须与调度点表一致。" TextWrapping="Wrap" Margin="0,12"/>
    <DataGrid x:Name="MappingGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="30">
     <DataGrid.Columns><DataGridTextColumn Header="工位/设备" Binding="{Binding Station}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="信号编号" Binding="{Binding Signal}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="信号" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="归属" Binding="{Binding Owner}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="DB号" Binding="{Binding Db}" Width="90"/><DataGridTextColumn Header="字节" Binding="{Binding Byte}" Width="90"/><DataGridTextColumn Header="位" Binding="{Binding Bit}" Width="70"/><DataGridCheckBoxColumn Header="启动初值" Binding="{Binding Initial}" Width="100"/></DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="导出JSON配置" Click="SaveConfig_Click"/><Button Content="导出调度CSV点表" Click="SaveMappingCsv_Click"/><TextBlock Text="S7子集：DB BOOL/BYTE读写；Rack/Slot协商兼容。不提供CPU启停、程序下载、M/I/Q区。" VerticalAlignment="Center"/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button Content="导出完整会话CSV" Click="ExportSession_Click"/><Button Content="一键导出联调证据ZIP" Click="ExportBundle_Click"/><Button x:Name="HistoryButton" Content="历史会话只读回看" Click="History_Click"/><Button x:Name="CancelExportButton" Content="取消导出" Click="CancelExport_Click" IsEnabled="False"/><TextBlock x:Name="ExportProgress" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><TextBlock x:Name="JournalLabel" Text="会话日志启动后保存到用户本机目录。关闭服务会断开调度连接，不清空界面记录。" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
 </Grid>
</Window>
